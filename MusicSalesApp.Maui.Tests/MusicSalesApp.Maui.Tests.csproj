<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Plugin.MediaManager" Version="1.2.2" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
  </ItemGroup>

  <!-- Include source files from MAUI project that are testable (no MAUI platform deps) -->
  <ItemGroup>
    <Compile Include="..\MusicSalesApp.Maui\ViewModels\*.cs" Link="ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\MusicSalesApp.Maui\Services\*.cs" Link="Services\%(Filename)%(Extension)" Exclude="..\MusicSalesApp.Maui\Services\AlertService.cs;..\MusicSalesApp.Maui\Services\SignalRService.cs;..\MusicSalesApp.Maui\Services\NavigationService.cs;..\MusicSalesApp.Maui\Services\BrowserService.cs" />
    <Compile Include="..\MusicSalesApp.Maui\Views\NowPlayingDrawerController.cs" Link="Views\NowPlayingDrawerController.cs" />
    <!-- The colour tokens. Pulled in because the C#-built pages compiled above reference
         them, and because a palette is worth having under test like anything else. -->
    <Compile Include="..\MusicSalesApp.Maui\Resources\Styles\AppColors.cs" Link="Resources\Styles\AppColors.cs" />
  </ItemGroup>

  <!--
    The app's XAML, copied to the output so XamlBindingContractTests can check every binding path
    against the ViewModel named by x:DataType. Views are not compiled here (they need the MAUI
    platform heads), so the markup is validated as text - a mistyped binding path otherwise fails
    silently at runtime with the whole suite green.
  -->
  <!--
    An explicit copy rather than None/CopyToOutputDirectory: UseMaui reclassifies .xaml items out of
    None into MauiXaml, which would try to compile these against a platform head this project has not
    got.
  -->
  <Target Name="CopyAppXamlForBindingTests" AfterTargets="Build">
    <ItemGroup>
      <AppXamlForBindingTests Include="..\MusicSalesApp.Maui\Views\*.xaml" />
    </ItemGroup>
    <Copy SourceFiles="@(AppXamlForBindingTests)"
          DestinationFolder="$(OutDir)AppXaml"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\MusicSalesApp\MusicSalesApp.Common\MusicSalesApp.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Microsoft.Maui.Controls" />
  </ItemGroup>

</Project>
