<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicSalesApp.Maui.Views.SubscriptionOfferCardView"
             x:Name="Root">
    <Border StrokeShape="RoundRectangle 8"
            Stroke="{StaticResource Primary}"
            BackgroundColor="{AppThemeBinding Light=#F2FFF7, Dark=#123321}"
            Padding="16">
        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding TitleText, Source={x:Reference Root}}"
                   FontSize="18"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light=#1a1a2e, Dark=White}" />
            <Label Text="{Binding BodyText, Source={x:Reference Root}}"
                   FontSize="14"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light=#1a1a2e, Dark=White}" />
            <Label Text="{Binding PriceText, Source={x:Reference Root}, StringFormat='Only {0}/month'}"
                   FontSize="16"
                   FontAttributes="Bold"
                   IsVisible="{Binding ShowPriceText, Source={x:Reference Root}}"
                   TextColor="{StaticResource Primary}" />
            <Label Text="{Binding DisclosureText, Source={x:Reference Root}}"
                   FontSize="12"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#b3b3b3}" />
            <HorizontalStackLayout Spacing="12">
                <Button Text="{Binding PrimaryButtonText, Source={x:Reference Root}}"
                        Command="{Binding PrimaryCommand, Source={x:Reference Root}}"
                        IsVisible="{Binding ShowPrimaryButton, Source={x:Reference Root}}"
                        IsEnabled="{Binding IsPrimaryButtonEnabled, Source={x:Reference Root}}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="24"
                        HeightRequest="44"
                        MinimumWidthRequest="120"
                        Padding="20,0" />
                <Button Text="{Binding SecondaryButtonText, Source={x:Reference Root}}"
                        Command="{Binding SecondaryCommand, Source={x:Reference Root}}"
                        IsVisible="{Binding ShowSecondaryButton, Source={x:Reference Root}}"
                        BackgroundColor="#8e44ad"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="24"
                        HeightRequest="44"
                        MinimumWidthRequest="100"
                        Padding="20,0" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
