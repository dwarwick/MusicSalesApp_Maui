<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicSalesApp.Maui.Views.SubscriptionOfferCardView"
             x:Name="Root">
    <Border StrokeShape="RoundRectangle 8"
            Stroke="{StaticResource Primary}"
            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}"
            Padding="16">
        <VerticalStackLayout Spacing="{StaticResource Space3}">
            <Label Text="{Binding TitleText, Source={x:Reference Root}}"
                   FontSize="{StaticResource FontSizeH4}"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            <Label Text="{Binding BodyText, Source={x:Reference Root}}"
                   FontSize="{StaticResource FontSizeCardTitle}"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            <Label Text="{Binding PriceText, Source={x:Reference Root}, StringFormat='Only {0}/month'}"
                   FontSize="{StaticResource FontSizeBodyLarge}"
                   FontAttributes="Bold"
                   IsVisible="{Binding ShowPriceText, Source={x:Reference Root}}"
                   TextColor="{StaticResource Primary}" />
            <Label Text="{Binding DisclosureText, Source={x:Reference Root}}"
                   FontSize="{StaticResource FontSizeCardMeta}"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
            <HorizontalStackLayout Spacing="{StaticResource Space3}">
                <Button Style="{StaticResource PillButtonPrimary}" Text="{Binding PrimaryButtonText, Source={x:Reference Root}}"
                        Command="{Binding PrimaryCommand, Source={x:Reference Root}}"
                        IsVisible="{Binding ShowPrimaryButton, Source={x:Reference Root}}"
                        IsEnabled="{Binding IsPrimaryButtonEnabled, Source={x:Reference Root}}"
                        MinimumWidthRequest="120" />
                <Button Style="{StaticResource PillButtonSecondary}" Text="{Binding SecondaryButtonText, Source={x:Reference Root}}"
                        Command="{Binding SecondaryCommand, Source={x:Reference Root}}"
                        IsVisible="{Binding ShowSecondaryButton, Source={x:Reference Root}}"
                        MinimumWidthRequest="100" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
