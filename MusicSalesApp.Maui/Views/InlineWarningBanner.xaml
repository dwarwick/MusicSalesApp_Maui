<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicSalesApp.Maui.Views.InlineWarningBanner"
             x:Name="Root">
    <Border StrokeShape="RoundRectangle 8"
            Stroke="{AppThemeBinding Light={StaticResource OfflineBannerLightBorder}, Dark={StaticResource OfflineBannerDarkBorder}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource OfflineBannerLightBackground}, Dark={StaticResource OfflineBannerDarkBackground}}"
            Padding="12,10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Label Text="⚠"
                   FontSize="16"
                   VerticalOptions="Start"
                   TextColor="{AppThemeBinding Light={StaticResource OfflineBannerLightText}, Dark={StaticResource OfflineBannerDarkText}}" />
            <Label Grid.Column="1"
                   Text="{Binding Text, Source={x:Reference Root}}"
                   FontSize="13"
                   LineBreakMode="WordWrap"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource OfflineBannerLightText}, Dark={StaticResource OfflineBannerDarkText}}" />
        </Grid>
    </Border>
</ContentView>
