<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MusicSalesApp.Maui.ViewModels"
             x:Class="MusicSalesApp.Maui.Views.MyPlaylistsPage"
             x:DataType="vm:MyPlaylistsViewModel"
             Title="My Playlists"
             SafeAreaEdges="Container"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12,16,16" RowSpacing="{StaticResource Space3}">

        <!-- Create button + subscription banner -->
        <VerticalStackLayout Grid.Row="0" Spacing="{StaticResource Space2}">
            <!-- Creating a playlist needs the server, so the control is hidden offline -->
            <Button Text="+ Create Playlist"
                    IsVisible="{Binding CanUseServerActions}"
                    Command="{Binding CreatePlaylistCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="20"
                    HeightRequest="{StaticResource ControlHeight}"
                    HorizontalOptions="Start"
                    Padding="20,0" />

            <Border IsVisible="{Binding HasActiveSubscription, Converter={toolkit:InvertedBoolConverter}}"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{StaticResource StAmber}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource WarnSoftLight}, Dark={StaticResource WarnSoftDark}}"
                    Padding="12,10">
                <Label Text="{Binding SubscriptionBannerText}"
                       FontSize="{StaticResource FontSizeSmall}"
                       TextColor="{AppThemeBinding Light={StaticResource TestingBannerLightText}, Dark={StaticResource TestingBannerDarkText}}" />
            </Border>
        </VerticalStackLayout>

        <!-- Error message -->
        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
               TextColor="{StaticResource DangerLight}"
               FontSize="{StaticResource FontSizeSmall}" />

        <!-- Playlist list -->
        <RefreshView Grid.Row="2"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsLoading}">
            <Grid>
                <!-- Empty state. Offline this must not read as "your playlists were deleted". -->
                <VerticalStackLayout IsVisible="{Binding ShowEmptyState}"
                                     VerticalOptions="Start"
                                     Spacing="6"
                                     Padding="24">
                    <Label Text="{Binding EmptyStateTitle}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                    <Label Text="{Binding EmptyStateDetail}"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                </VerticalStackLayout>

                <!-- Playlist cards -->
                <CollectionView IsVisible="{Binding ShowPlaylists}"
                                ItemsSource="{Binding Playlists}"
                                ItemSizingStrategy="MeasureFirstItem"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaylistDto">
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Margin="0,0,0,10"
                                    Padding="14"
                                    MinimumHeightRequest="72">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyPlaylistsViewModel}}, Path=OpenPlaylistCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space2}" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="{StaticResource FontSizeBodyLarge}"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                        <Label Text="{Binding SongCount, StringFormat='{0} songs'}"
                                               FontSize="{StaticResource FontSizeCardMeta}"
                                               TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                                    </VerticalStackLayout>
                                    <!-- Edit controls: hidden for system playlists, and hidden entirely
                                         while offline since renaming and deleting both need the server. -->
                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="{StaticResource Space2}"
                                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MyPlaylistsViewModel}}, Path=CanUseServerActions}">
                                        <!-- Rename (hidden for system playlists) -->
                                        <Button Text="✎"
                                                FontSize="{StaticResource FontSizeH4}"
                                                HeightRequest="{StaticResource ArtSizeMini}"
                                                WidthRequest="40"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                                                IsVisible="{Binding IsSystemGenerated, Converter={toolkit:InvertedBoolConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyPlaylistsViewModel}}, Path=RenamePlaylistCommand}"
                                                CommandParameter="{Binding .}" />
                                        <!-- Delete (hidden for system playlists) -->
                                        <Button Text="🗑"
                                                FontSize="{StaticResource FontSizeBodyLarge}"
                                                HeightRequest="{StaticResource ArtSizeMini}"
                                                WidthRequest="40"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource DangerLight}"
                                                IsVisible="{Binding IsSystemGenerated, Converter={toolkit:InvertedBoolConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyPlaylistsViewModel}}, Path=DeletePlaylistCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                    <!-- Play -->
                                    <Label Grid.Column="2"
                                           Text="▶"
                                           FontSize="{StaticResource FontSizeH2Compact}"
                                           TextColor="{StaticResource Primary}"
                                           VerticalTextAlignment="Center"
                                           Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>

    </Grid>

</ContentPage>
