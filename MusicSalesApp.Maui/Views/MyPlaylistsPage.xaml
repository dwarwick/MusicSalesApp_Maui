<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MusicSalesApp.Maui.ViewModels"
             x:Class="MusicSalesApp.Maui.Views.MyPlaylistsPage"
             x:DataType="vm:MyPlaylistsViewModel"
             Title="My Playlists"
             SafeAreaEdges="Container"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12,16,16" RowSpacing="{StaticResource Space3}">

        <!-- Create button + subscription banner -->
        <VerticalStackLayout Grid.Row="0" Spacing="{StaticResource Space2}">
            <!-- Creating a playlist needs the server, so the control is hidden offline -->
            <Button Style="{StaticResource PillButtonPrimary}"
                    Text="+ Create Playlist"
                    IsVisible="{Binding CanUseServerActions}"
                    Command="{Binding CreatePlaylistCommand}"
                    HorizontalOptions="Start" />

            <Border IsVisible="{Binding HasActiveSubscription, Converter={toolkit:InvertedBoolConverter}}"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{StaticResource StAmber}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource WarnSoftLight}, Dark={StaticResource WarnSoftDark}}"
                    Padding="12,10">
                <Label Text="{Binding SubscriptionBannerText}"
                       FontSize="{StaticResource FontSizeSmall}"
                       TextColor="{AppThemeBinding Light={StaticResource TestingBannerLightText}, Dark={StaticResource TestingBannerDarkText}}" />
            </Border>
        </VerticalStackLayout>

        <!-- Error message -->
        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
               TextColor="{StaticResource DangerLight}"
               FontSize="{StaticResource FontSizeSmall}" />

        <!-- Playlist list -->
        <RefreshView Grid.Row="2"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsLoading}">
            <Grid>
                <!--
                    One scroll container for the whole page.

                    The most-streamed section lives in the CollectionView's Header, and the empty
                    state moved into EmptyView, so that section renders whether or not the user has
                    playlists of their own. Previously the list carried IsVisible="{Binding
                    ShowPlaylists}", which would have hidden the header for exactly the new user who
                    has nothing else to look at.

                    A plain Header rather than a HeaderTemplate, so the BindingContext stays the
                    ViewModel and the page's x:DataType keeps resolving.
                -->
                <CollectionView ItemsSource="{Binding Playlists}"
                                ItemSizingStrategy="MeasureFirstItem"
                                SelectionMode="None">
                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="{StaticResource Space3}"
                                             Padding="0,0,0,16">
                            <!--
                                Recommended. Deliberately unheaded: the server names the row
                                "Recommended For You", so a "Recommended" heading above a single row
                                of that name would only repeat itself.
                            -->
                            <Border IsVisible="{Binding ShowRecommended}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                                    StrokeThickness="{StaticResource StrokeThin}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenPlaylistCommand}"
                                                          CommandParameter="{Binding RecommendedPlaylist}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space2}" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource SpaceHair}">
                                        <Label Text="{Binding RecommendedPlaylist.Name}"
                                               FontSize="{StaticResource FontSizeCardTitle}"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                        <Label Text="{Binding RecommendedPlaylist.SongCount, StringFormat='{0} songs'}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="▶"
                                           FontSize="{StaticResource FontSizeH2}"
                                           TextColor="{StaticResource Primary}"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout IsVisible="{Binding ShowTopStreamed}"
                                                 Spacing="{StaticResource Space3}">
                                <VerticalStackLayout Spacing="{StaticResource SpaceHair}">
                                    <Label Text="Most Streamed"
                                           FontSize="{StaticResource FontSizeH2Compact}"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                    <Label Text="Updated daily"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopStreamedPlaylists}"
                                                     Spacing="{StaticResource Space2}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlaylistDto">
                                            <Border StrokeShape="RoundRectangle 12"
                                                    Stroke="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                                                    StrokeThickness="{StaticResource StrokeThin}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                                    Padding="14">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyPlaylistsViewModel}}, Path=OpenPlaylistCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space2}" VerticalOptions="Center">
                                                    <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource SpaceHair}">
                                                        <Label Text="{Binding Name}"
                                                               FontSize="{StaticResource FontSizeCardTitle}"
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                                        <Label Text="{Binding SongCount, StringFormat='{0} songs'}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1"
                                                           Text="▶"
                                                           FontSize="{StaticResource FontSizeH2}"
                                                           TextColor="{StaticResource Primary}"
                                                           VerticalTextAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Only earns its place below a generated section it has to be told apart from. -->
                            <Label Text="My Playlists"
                                   IsVisible="{Binding ShowGeneratedPlaylists}"
                                   FontSize="{StaticResource FontSizeH2Compact}"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <!-- Empty state. Offline this must not read as "your playlists were deleted". -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Start"
                                             Spacing="{StaticResource SpaceTight}"
                                             Padding="24">
                            <Label Text="{Binding EmptyStateTitle}"
                                   FontSize="{StaticResource FontSizeBodyLarge}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                            <Label Text="{Binding EmptyStateDetail}"
                                   FontSize="{StaticResource FontSizeCardTitle}"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaylistDto">
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Margin="0,0,0,10"
                                    Padding="14"
                                    MinimumHeightRequest="72">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyPlaylistsViewModel}}, Path=OpenPlaylistCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Space2}" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource SpaceHair}" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="{StaticResource FontSizeBodyLarge}"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                        <Label Text="{Binding SongCount, StringFormat='{0} songs'}"
                                               FontSize="{StaticResource FontSizeCardMeta}"
                                               TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                                    </VerticalStackLayout>
                                    <!-- Edit controls: hidden for system playlists, and hidden entirely
                                         while offline since renaming and deleting both need the server. -->
                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="{StaticResource Space2}"
                                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:MyPlaylistsViewModel}}, Path=CanUseServerActions}">
                                        <!-- Rename (hidden for system playlists) -->
                                        <Button Text="✎"
                                                FontSize="{StaticResource FontSizeH4}"
                                                HeightRequest="{StaticResource ArtSizeMini}"
                                                WidthRequest="40"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                                                IsVisible="{Binding IsSystemGenerated, Converter={toolkit:InvertedBoolConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyPlaylistsViewModel}}, Path=RenamePlaylistCommand}"
                                                CommandParameter="{Binding .}" />
                                        <!-- Delete (hidden for system playlists) -->
                                        <Button Text="🗑"
                                                FontSize="{StaticResource FontSizeBodyLarge}"
                                                HeightRequest="{StaticResource ArtSizeMini}"
                                                WidthRequest="40"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource DangerLight}"
                                                IsVisible="{Binding IsSystemGenerated, Converter={toolkit:InvertedBoolConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyPlaylistsViewModel}}, Path=DeletePlaylistCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                    <!-- Play -->
                                    <Label Grid.Column="2"
                                           Text="▶"
                                           FontSize="{StaticResource FontSizeH2Compact}"
                                           TextColor="{StaticResource Primary}"
                                           VerticalTextAlignment="Center"
                                           Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>

    </Grid>

</ContentPage>
