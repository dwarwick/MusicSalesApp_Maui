<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MusicSalesApp.Maui.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:MusicSalesApp.Maui.Views"
             x:Class="MusicSalesApp.Maui.Views.ConfigPage"
             x:DataType="vm:ConfigViewModel"
             Title="Config"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ContentPage.Resources>
        <!-- The picker shows the shared display names, so the app and the web account page cannot
             drift apart on what "every 12 hours" is called. -->
        <views:PushFrequencyConverter x:Key="PushFrequencyConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24,24" Spacing="{StaticResource Space5}">
            <VerticalStackLayout Spacing="{StaticResource Space1}">
                <Label Text="Config"
                       FontSize="{StaticResource FontSizeH2Compact}"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                <Label Text="Offline cache"
                       FontSize="{StaticResource FontSizeBody}"
                       TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space4}">
                <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource Space1}">
                    <Label Text="Space used"
                           FontSize="{StaticResource FontSizeH4}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                    <Label Text="Storage currently used by downloaded songs on this device."
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                </VerticalStackLayout>

                <Label Grid.Column="1"
                       Text="{Binding CacheUsageDisplay}"
                       FontSize="{StaticResource FontSizeH4}"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            </Grid>

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

            <VerticalStackLayout Spacing="{StaticResource Space4}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space4}">
                    <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource Space1}">
                        <Label Text="Cache size"
                               FontSize="{StaticResource FontSizeH4}"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        <Label Text="Max potential storage for prepared audio on this device."
                               FontSize="{StaticResource FontSizeCardTitle}"
                               TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                    </VerticalStackLayout>

                    <Label Grid.Column="1"
                           Text="{Binding OfflineCacheLimitDisplay}"
                           FontSize="{StaticResource FontSizeH4}"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                </Grid>

                <Slider Minimum="{Binding MinimumCacheLimitMb}"
                        Maximum="{Binding MaximumCacheLimitMb}"
                        Value="{Binding OfflineCacheLimitMb, Mode=TwoWay}"
                        MinimumTrackColor="{StaticResource AccentFillLight}"
                        MaximumTrackColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                        ThumbColor="{StaticResource AccentFillLight}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding MinimumCacheLimitDisplay}"
                           FontSize="{StaticResource FontSizeCardMeta}"
                           TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                    <Label Grid.Column="1"
                           Text="{Binding MaximumCacheLimitDisplay}"
                           FontSize="{StaticResource FontSizeCardMeta}"
                           TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                </Grid>

                <Label FontSize="{StaticResource FontSizeSmall}"
                       TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="StreamTunes may use less than this limit when device free space reaches the " />
                            <Span Text="{Binding DeviceFreeSpaceReserveDisplay}" />
                            <Span Text=" reserve." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Button Text="Reset to 1 GB"
                        Command="{Binding ResetOfflineCacheLimitCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                        FontAttributes="Bold"
                        CornerRadius="{StaticResource RadiusSmInt}"
                        HeightRequest="{StaticResource ControlHeight}"
                        HorizontalOptions="Start"
                        Padding="20,0" />
            </VerticalStackLayout>

            <!-- Notification frequency. Hidden until the preferences have been read, because it is
                 an account setting the server enforces - a picker that could not save would be
                 worse than no picker. -->
            <VerticalStackLayout Spacing="{StaticResource Space4}"
                                 IsVisible="{Binding IsNotificationFrequencyAvailable}">
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

                <VerticalStackLayout Spacing="{StaticResource Space1}">
                    <Label Text="Notifications"
                           FontSize="{StaticResource FontSizeH4}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                    <Label Text="How often artists you follow may notify you."
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                </VerticalStackLayout>

                <Picker ItemsSource="{Binding NotificationFrequencies}"
                        SelectedItem="{Binding NotificationFrequency}"
                        IsEnabled="{Binding IsSavingNotificationFrequency, Converter={toolkit:InvertedBoolConverter}}"
                        ItemDisplayBinding="{Binding ., Converter={StaticResource PushFrequencyConverter}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                        HorizontalOptions="Fill" />

                <Label Text="{Binding NotificationFrequencyDescription}"
                       FontSize="{StaticResource FontSizeSmall}"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />

                <Label Text="{Binding NotificationFrequencyStatus}"
                       FontSize="{StaticResource FontSizeSmall}"
                       IsVisible="{Binding NotificationFrequencyStatus, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                       TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
