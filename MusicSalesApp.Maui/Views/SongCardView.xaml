<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MusicSalesApp.Maui.ViewModels"
             xmlns:views="clr-namespace:MusicSalesApp.Maui.Views"
             x:Class="MusicSalesApp.Maui.Views.SongCardView"
             x:Name="Root"
             x:DataType="vm:SongDto">

    <ContentView.Resources>
        <views:DurationConverter x:Key="DurationConverter" />
        <views:LikeGlyphConverter x:Key="LikeGlyphConverter" />
        <views:DislikeGlyphConverter x:Key="DislikeGlyphConverter" />
        <views:LikeFillConverter x:Key="LikeFillConverter" />
        <views:DislikeFillConverter x:Key="DislikeFillConverter" />
    </ContentView.Resources>

    <Border Margin="8,4"
            Padding="12"
            StrokeShape="RoundRectangle 8"
            Stroke="Transparent"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference Root}, Path=OpenSongCommand}"
                CommandParameter="{Binding .}" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="8">
            <Grid HorizontalOptions="Center"
                  HeightRequest="150"
                  WidthRequest="150">
                <Border HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        HeightRequest="150"
                        WidthRequest="150">
                    <views:SongArtworkView AlbumArtUrl="{Binding AlbumArtUrl}"
                                           HeightRequest="150"
                                           WidthRequest="150" />
                </Border>
                <Image Source="ai_generated_badge.png"
                                             HeightRequest="40"
                                             WidthRequest="40"
                                             Margin="0,0,8,8"
                                             Opacity="0.3"
                      Aspect="AspectFit"
                       HorizontalOptions="End"
                       VerticalOptions="End"
                       InputTransparent="True"
                       IsVisible="{Binding IsAiGenerated}" />
            </Grid>

            <Label Text="{Binding SongTitle}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   LineBreakMode="TailTruncation"
                   MaxLines="1"
                   HorizontalTextAlignment="Center" />

            <HorizontalStackLayout HorizontalOptions="Center"
                                    Spacing="6">
                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        HeightRequest="20"
                        WidthRequest="20"
                        VerticalOptions="Center"
                        IsVisible="{Binding PersonaImageUrl, Converter={toolkit:IsNotNullConverter}}">
                    <Image Source="{Binding PersonaImageUrl}"
                           Aspect="AspectFill"
                           HeightRequest="20"
                           WidthRequest="20" />
                </Border>
                <Label Text="{Binding ArtistName}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       VerticalOptions="Center"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference Root}, Path=NavigateToArtistCommand}"
                            CommandParameter="{Binding ArtistName}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <HorizontalStackLayout HorizontalOptions="Center"
                                    Spacing="4">
                <Label Text="{Binding Genre}"
                       FontSize="12"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{StaticResource Primary}"
                       TextDecorations="Underline"
                       IsVisible="{Binding Genre, Converter={toolkit:IsStringNotNullOrEmptyConverter}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference Root}, Path=NavigateToGenreCommand}"
                            CommandParameter="{Binding Genre}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="·"
                       FontSize="12"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource StreamIconLight}, Dark={StaticResource StreamIconDark}}"
                       IsVisible="{Binding Genre, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />
                <Label FontSize="12"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource StreamIconLight}, Dark={StaticResource StreamIconDark}}">
                    <Label.Text>
                        <Binding Path="StreamCount"
                                 StringFormat="{}{0:N0} streams" />
                    </Label.Text>
                </Label>
                <Label Text="·"
                       FontSize="12"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource StreamIconLight}, Dark={StaticResource StreamIconDark}}" />
                <Label FontSize="12"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource StreamIconLight}, Dark={StaticResource StreamIconDark}}"
                       Text="{Binding TrackLengthSeconds, Converter={StaticResource DurationConverter}}" />
                <Label Text="·"
                       FontSize="12"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource StreamIconLight}, Dark={StaticResource StreamIconDark}}" />

                <Grid HeightRequest="32"
                      WidthRequest="32"
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference Root}, Path=LikeSongCommand}"
                            CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                    <Path Data="{Binding UserLikeStatus, Converter={StaticResource LikeGlyphConverter}}"
                          Fill="{Binding UserLikeStatus, Converter={StaticResource LikeFillConverter}}"
                          Aspect="Uniform"
                          HeightRequest="18"
                          WidthRequest="18"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Grid>
                <Label Text="{Binding LikeCount}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource LikeButtonDarkText}}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />

                <Grid HeightRequest="32"
                      WidthRequest="32"
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference Root}, Path=DislikeSongCommand}"
                            CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                    <Path Data="{Binding UserLikeStatus, Converter={StaticResource DislikeGlyphConverter}}"
                          Fill="{Binding UserLikeStatus, Converter={StaticResource DislikeFillConverter}}"
                          Aspect="Uniform"
                          HeightRequest="18"
                          WidthRequest="18"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Grid>
                <Label Text="{Binding DislikeCount}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource LikeButtonDarkText}}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
                  ColumnSpacing="6"
                  HorizontalOptions="Center">
                <views:FacebookShareButton Grid.Column="0"
                                           ShareUrl="{Binding ShareUrl}"
                               IsVisible="{Binding Source={x:Reference Root}, Path=ShowFacebookShareButton}"
                                           VerticalOptions="Center" />

                <views:ShareButton Grid.Column="1"
                                   ShareTitle="{Binding SongTitle}"
                                   ShareUrl="{Binding ShareUrl}"
                           IsVisible="{Binding Source={x:Reference Root}, Path=ShowShareButton}"
                                   VerticalOptions="Center" />

                <views:AddToPlaylistButton Grid.Column="2"
                                           SongId="{Binding Id}"
                                           SongTitle="{Binding SongTitle}"
                               IsVisible="{Binding Source={x:Reference Root}, Path=ShowAddToPlaylistButton}"
                                           VerticalOptions="Center" />

                                <views:TipButton Grid.Column="3"
                                                                 SongId="{Binding Id}"
                                                                 SongTitle="{Binding SongTitle}"
                                                                 CreatorId="{Binding CreatorId}"
                                                                 CreatorUserId="{Binding CreatorUserId}"
                                                                 VerticalOptions="Center" />

                                <Grid Grid.Column="4"
                      HeightRequest="32"
                      WidthRequest="32">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference Root}, Path=ReportSongCommand}"
                            CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                    <Path Data="M3 3v18h2V3H3zm4 0v12h8l-2-6 2-6H7z"
                          Fill="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource LikeButtonDarkText}}"
                          Aspect="Uniform"
                          HeightRequest="16"
                          WidthRequest="16"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Grid>

                <views:EqualizerPlayButton Grid.Column="6"
                                           SongId="{Binding Id}"
                                           Command="{Binding Source={x:Reference Root}, Path=PlaySongCommand}"
                                           CommandParameter="{Binding .}"
                                           ButtonSize="40"
                                           VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
