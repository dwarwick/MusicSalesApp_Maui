<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MusicSalesApp.Maui.ViewModels"
             xmlns:views="clr-namespace:MusicSalesApp.Maui.Views"
             x:Class="MusicSalesApp.Maui.Views.PlaylistPlayerPage"
             x:DataType="vm:PlaylistPlayerViewModel"
             Title="{Binding PlaylistTitle}"
             SafeAreaEdges="Container"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="*,Auto">
        <!-- Scrollable content: now-playing hero + track list -->
        <RefreshView Grid.Row="0"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsLoading, Mode=OneWay}">
            <CollectionView ItemsSource="{Binding Songs}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.Header>
                <VerticalStackLayout Spacing="0">

                <!-- Loading indicator -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center"
                                   Margin="0,24,0,0"
                                   Color="{StaticResource Primary}" />

                <!-- Error message -->
                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={toolkit:IsNotNullConverter}}"
                       TextColor="Red"
                       FontSize="{StaticResource FontSizeCardTitle}"
                       HorizontalTextAlignment="Center"
                       Margin="20,16" />

                <!-- Now-Playing Hero Section -->
                <VerticalStackLayout Spacing="{StaticResource Space4}"
                                     Padding="20,24,20,16"
                                     IsVisible="{Binding CurrentSong, Converter={toolkit:IsNotNullConverter}}">

                    <!-- Large Album Art -->
                                  <Grid HorizontalOptions="Center"
                                      HeightRequest="{StaticResource PlayerHeroArtSize}"
                                      WidthRequest="{StaticResource PlayerHeroArtSize}">
                           <Border HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">
                            <views:SongArtworkView AlbumArtUrl="{Binding CurrentSong.AlbumArtHeroDisplaySource}"
                                          HeightRequest="{StaticResource PlayerHeroArtSize}"
                                          WidthRequest="{StaticResource PlayerHeroArtSize}" />
                           </Border>
                          </Grid>

                    <views:AiContentBadgesView IsAiMusic="{Binding CurrentSong.IsAiGenerated}"
                                                IsAiVocals="{Binding CurrentSong.IsAiVocals}"
                                                IsAiLyrics="{Binding CurrentSong.IsAiLyrics}"
                                                BadgeSize="34"
                                                HorizontalOptions="Center" />

                    <!-- Song Title -->
                    <Label Text="{Binding CurrentSong.SongTitle}"
                           FontSize="{StaticResource FontSizeH2}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           MaxLines="2" />

                    <!-- Artist Name (tappable → artist playlist) -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="{StaticResource Space2}">
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                HeightRequest="24"
                                WidthRequest="24"
                                VerticalOptions="Center"
                                IsVisible="{Binding CurrentSong.PersonaImageThumbDisplaySource, Converter={toolkit:IsNotNullConverter}}">
                            <Image Source="{Binding CurrentSong.PersonaImageThumbDisplaySource}"
                                   Aspect="AspectFill"
                                   HeightRequest="24"
                                   WidthRequest="24" />
                        </Border>
                        <Label Text="{Binding CurrentSong.ArtistName}"
                               FontSize="{StaticResource FontSizeBodyLarge}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center"
                               TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToArtistCommand}"
                                                      CommandParameter="{Binding CurrentSong.ArtistName}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <views:PersonaSectionView PersonaName="{Binding CurrentSong.ArtistName}"
                                              Bio="{Binding CurrentSong.PersonaBio}"
                                              ImageSource="{Binding CurrentSong.PersonaImageHeroDisplaySource}"
                                              NavigateCommand="{Binding NavigateToArtistCommand}" />

                    <!-- Genre (tappable → genre playlist) · Stream Count · Duration -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="{StaticResource SpaceTight}">
                        <Border Padding="8,4"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                BackgroundColor="Transparent"
                                IsVisible="{Binding CurrentSong.Genre, Converter={toolkit:IsStringNotNullOrEmptyConverter}}">
                            <Label Text="{Binding CurrentSong.Genre}"
                                   FontSize="{StaticResource FontSizeCardMeta}"
                                   TextColor="{StaticResource Primary}"
                                   TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToGenreCommand}"
                                                          CommandParameter="{Binding CurrentSong.Genre}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Label Text="·"
                               FontSize="{StaticResource FontSizeCardTitle}"
                               TextColor="{AppThemeBinding Light={StaticResource StreamIconLight}, Dark={StaticResource StreamIconDark}}"
                               VerticalOptions="Center"
                               IsVisible="{Binding CurrentSong.Genre, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />
                           <views:EqualizerPlayButton SongId="{Binding CurrentSong.Id}"
                                          Command="{Binding PlayTrackCommand}"
                                          CommandParameter="{Binding CurrentSong}"
                                          ButtonSize="40"
                                          VerticalOptions="Center" />
                        <Label FontSize="{StaticResource FontSizeSmall}"
                               TextColor="{AppThemeBinding Light={StaticResource StreamIconLight}, Dark={StaticResource StreamIconDark}}"
                               VerticalOptions="Center">
                            <Label.Text>
                                <Binding Path="CurrentSong.StreamCount"
                                         StringFormat="{}{0:N0} streams" />
                            </Label.Text>
                        </Label>
                        <Label Text="·"
                               FontSize="{StaticResource FontSizeCardTitle}"
                               TextColor="{AppThemeBinding Light={StaticResource StreamIconLight}, Dark={StaticResource StreamIconDark}}"
                               VerticalOptions="Center" />
                        <Label FontSize="{StaticResource FontSizeSmall}"
                               TextColor="{AppThemeBinding Light={StaticResource StreamIconLight}, Dark={StaticResource StreamIconDark}}"
                               VerticalOptions="Center"
                               Text="{Binding CurrentSong.TrackLengthSeconds, Converter={StaticResource DurationConverter}}" />
                    </HorizontalStackLayout>

                    <!-- Subscription Badge (hidden for subscribers) -->
                    <Border HorizontalOptions="Center"
                            Padding="12,6"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            IsVisible="{Binding IsCurrentTrackPreviewLimited}"
                            BackgroundColor="{StaticResource StAmber}">
                        <Label FontSize="{StaticResource FontSizeCardMeta}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnWarn}"
                               HorizontalTextAlignment="Center"
                               Text="Preview Only (60 seconds)" />
                    </Border>

                    <!-- Action Row: Like, Dislike, Share, Report -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="{StaticResource Space4}">

                        <!-- Like Button -->
                        <VerticalStackLayout VerticalOptions="Center" Spacing="{StaticResource SpaceHair}">
                            <Grid HeightRequest="40" WidthRequest="40" HorizontalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LikeSongCommand}" />
                                </Grid.GestureRecognizers>
                                <Path Data="{Binding CurrentSong.UserLikeStatus, Converter={StaticResource LikeGlyphConverter}}"
                                      Fill="{Binding CurrentSong.UserLikeStatus, Converter={StaticResource LikeFillConverter}}"
                                      Aspect="Uniform"
                                      HeightRequest="24" WidthRequest="24"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding CurrentSong.LikeCount}"
                                   FontSize="{StaticResource FontSizeMicro}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource LikeButtonDarkText}}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Dislike Button -->
                        <VerticalStackLayout VerticalOptions="Center" Spacing="{StaticResource SpaceHair}">
                            <Grid HeightRequest="40" WidthRequest="40" HorizontalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DislikeSongCommand}" />
                                </Grid.GestureRecognizers>
                                <Path Data="{Binding CurrentSong.UserLikeStatus, Converter={StaticResource DislikeGlyphConverter}}"
                                      Fill="{Binding CurrentSong.UserLikeStatus, Converter={StaticResource DislikeFillConverter}}"
                                      Aspect="Uniform"
                                      HeightRequest="24" WidthRequest="24"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding CurrentSong.DislikeCount}"
                                   FontSize="{StaticResource FontSizeMicro}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource LikeButtonDarkText}}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Facebook Share Button -->
                        <views:FacebookShareButton ShareUrl="{Binding ShareUrl}"
                                                   VerticalOptions="Center" />

                        <!-- Share Button -->
                        <views:ShareButton ShareTitle="{Binding CurrentSong.SongTitle}"
                                           ShareUrl="{Binding ShareUrl}"
                                           VerticalOptions="Center" />

                        <!-- Add to Playlist Button -->
                        <views:AddToPlaylistButton SongId="{Binding CurrentSong.Id}"
                                                   SongTitle="{Binding CurrentSong.SongTitle}"
                                                   VerticalOptions="Center" />

                        <!-- Tip Button -->
                        <views:TipButton SongId="{Binding CurrentSong.Id}"
                                         SongTitle="{Binding CurrentSong.SongTitle}"
                                         CreatorId="{Binding CurrentSong.CreatorId}"
                                         CreatorUserId="{Binding CurrentSong.CreatorUserId}"
                                         VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Track List Header -->
                <Grid ColumnDefinitions="*,Auto"
                      Padding="20,8,20,4"
                      IsVisible="{Binding ShowTracksHeader}">
                    <Label Grid.Column="0"
                           Text="Tracks"
                           FontSize="{StaticResource FontSizeH4}"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                </Grid>

                <!-- Editing a playlist needs the server, so say so rather than silently hiding the controls -->
                <views:InlineWarningBanner IsVisible="{Binding ShowOfflineEditingNotice}"
                                           AutomationId="OfflinePlaylistEditingNotice"
                                           Margin="20,4"
                                           Text="Editing playlists isn&apos;t available offline. Reconnect to add, remove or reorder tracks." />

                <!-- Empty custom-playlist call-to-action -->
                <VerticalStackLayout IsVisible="{Binding ShowEmptyPlaylistPrompt}"
                                     Padding="20,12"
                                     Spacing="{StaticResource Space3}"
                                     HorizontalOptions="Center">
                    <Label Text="This playlist is empty."
                           FontSize="{StaticResource FontSizeBody}"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                    <Label Text="Browse the Music Library and tap the add-to-playlist icon on any song to add it here."
                           FontSize="{StaticResource FontSizeSmall}"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                    <Button Text="Open Music Library"
                            FontSize="{StaticResource FontSizeCardTitle}"
                            Padding="16,8"
                            HeightRequest="40"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            HorizontalOptions="Center"
                            Command="{Binding GoToMusicLibraryCommand}" />
                </VerticalStackLayout>

                </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SongDto">
                            <Border Margin="8,2"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 6"
                                    Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistPlayerViewModel}}, Path=PlayTrackCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                  <Grid ColumnDefinitions="Auto,48,*,Auto,Auto,Auto"
                                      ColumnSpacing="{StaticResource Space2}">

                                    <!-- Reorder up/down (only for custom playlists + subscription) -->
                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="0"
                                                         VerticalOptions="Center"
                                                         IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistPlayerViewModel}}, Path=IsReorderEnabled}">
                                        <Button Text="▲"
                                                FontSize="{StaticResource FontSizeCardMeta}"
                                                HeightRequest="22"
                                                WidthRequest="28"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistPlayerViewModel}}, Path=MoveTrackUpCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="▼"
                                                FontSize="{StaticResource FontSizeCardMeta}"
                                                HeightRequest="22"
                                                WidthRequest="28"
                                                Padding="0"
                                                BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistPlayerViewModel}}, Path=MoveTrackDownCommand}"
                                                CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>

                                    <!-- Mini Album Art -->
                                    <Border Grid.Column="1"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="0"
                                            HeightRequest="{StaticResource ArtSizeThumb}"
                                            WidthRequest="{StaticResource ArtSizeThumb}">
                                        <views:SongArtworkView AlbumArtUrl="{Binding AlbumArtThumbDisplaySource}"
                                               HeightRequest="{StaticResource ArtSizeThumb}"
                                               WidthRequest="{StaticResource ArtSizeThumb}" />
                                    </Border>

                                    <!-- Song Info -->
                                    <VerticalStackLayout Grid.Column="2"
                                                         VerticalOptions="Center"
                                                         Spacing="{StaticResource SpaceHair}">
                                        <Label Text="{Binding SongTitle}"
                                               FontSize="{StaticResource FontSizeCardTitle}"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Text="{Binding ArtistName}"
                                               FontSize="{StaticResource FontSizeCardMeta}"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </VerticalStackLayout>

                                    <!-- Duration -->
                                    <Label Grid.Column="3"
                                           FontSize="{StaticResource FontSizeCardMeta}"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                           VerticalOptions="Center"
                                           Text="{Binding TrackLengthSeconds, Converter={StaticResource DurationConverter}}" />

                                     <!-- Tip Button -->
                                     <views:TipButton Grid.Column="4"
                                                SongId="{Binding Id}"
                                                SongTitle="{Binding SongTitle}"
                                                CreatorId="{Binding CreatorId}"
                                                CreatorUserId="{Binding CreatorUserId}"
                                                VerticalOptions="Center" />

                                    <!-- Remove from playlist (custom playlists only) -->
                                     <Button Grid.Column="5"
                                            Text="✕"
                                            FontSize="{StaticResource FontSizeCardTitle}"
                                            HeightRequest="{StaticResource ControlHeightSmall}"
                                            WidthRequest="{StaticResource ControlHeightSmall}"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistPlayerViewModel}}, Path=CanEditPlaylist}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistPlayerViewModel}}, Path=RemoveSongFromPlaylistCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>                            </Border>
                        </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Now Playing Bar at bottom -->
        <views:NowPlayingView x:Name="NowPlayingBar"
                              CollapseWhenEmpty="False"
                              Grid.Row="1" />

        <!-- Removed: bulk Add-Songs modal. Use the per-song AddToPlaylistButton instead. -->
    </Grid>

</ContentPage>
