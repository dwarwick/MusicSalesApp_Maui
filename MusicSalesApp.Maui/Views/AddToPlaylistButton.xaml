             x:Class="MusicSalesApp.Maui.Views.AddToPlaylistButton">

    <Grid x:Name="AddBtn"
          HeightRequest="{StaticResource ArtSizeMini}"
          WidthRequest="{StaticResource ArtSizeMini}"
          VerticalOptions="Center">
        <!-- Plus-in-rectangle glyph (playlist-add) -->
