<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MusicSalesApp.Maui.ViewModels"
             xmlns:views="clr-namespace:MusicSalesApp.Maui.Views"
             x:Class="MusicSalesApp.Maui.Views.SongPlayerPage"
             x:DataType="vm:SongPlayerViewModel"
             Title="Now Playing"
             SafeAreaEdges="Container"
             BackgroundColor="{StaticResource PlayerBg}">

    <Grid RowDefinitions="*,Auto">
        <!-- Scrollable song details -->
        <RefreshView Grid.Row="0"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=OneWay}">
            <ScrollView Padding="0">
                <VerticalStackLayout Spacing="{StaticResource Space4}"
                                     Padding="20,24,20,16">

                <!-- THE STAGE PANEL. Mirrors the web's .playlist-stage-panel: a bordered section
                     whose header carries an uppercase caption naming what is on show, and - only
                     when the song HAS lyrics a listener may see - a segmented switch between them.

                     The art and the lyrics swap rather than overlaying, so the panel keeps its
                     height and nothing below it shifts when the switch is pressed. -->
                <Border Style="{StaticResource PlayerPanel}"
                        Padding="{StaticResource Space3}">
                    <VerticalStackLayout Spacing="{StaticResource Space3}">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="StageCaption"
                                   Grid.Column="0"
                                   Style="{StaticResource PlayerPanelCaption}"
                                   Text="COVER ART" />

                            <!-- The switch, not a corner bubble on the artwork. Hidden entirely
                                 when there is nothing to switch to, which leaves an ordinary
                                 captioned panel rather than a header with a gap in it. -->
                            <Border x:Name="StageSwitch"
                                    Grid.Column="1"
                                    IsVisible="False"
                                    Padding="0"
                                    StrokeThickness="{StaticResource StrokeThin}"
                                    Stroke="{StaticResource PlayerLine}"
                                    StrokeShape="RoundRectangle 999"
                                    BackgroundColor="Transparent">
                                <HorizontalStackLayout>
                                    <Button x:Name="LyricsSegment"
                                            Text="Lyrics"
                                            Style="{StaticResource PlayerSwitchSegment}"
                                            Clicked="OnShowLyricsClicked" />
                                    <Button x:Name="ArtSegment"
                                            Text="Art"
                                            Style="{StaticResource PlayerSwitchSegmentActive}"
                                            Clicked="OnShowArtClicked" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Grid HorizontalOptions="Center"
                              HeightRequest="{StaticResource PlayerHeroArtSize}"
                              WidthRequest="{StaticResource PlayerHeroArtSize}">
                            <Border x:Name="HeroArt"
                                    HorizontalOptions="Center"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0">
                                <views:SongArtworkView AlbumArtUrl="{Binding Song.AlbumArtHeroDisplaySource}"
                                                       HeightRequest="{StaticResource PlayerHeroArtSize}"
                                                       WidthRequest="{StaticResource PlayerHeroArtSize}" />
                            </Border>

                            <views:LyricsView x:Name="LyricsPanel"
                                              IsVisible="False"
                                              OnDarkSurface="True"
                                              TextSize="{StaticResource FontSizeLyricsPlayer}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <views:AiContentBadgesView IsAiMusic="{Binding Song.IsAiGenerated}"
                                            IsAiVocals="{Binding Song.IsAiVocals}"
                                            IsAiLyrics="{Binding Song.IsAiLyrics}"
                                            BadgeSize="34"
                                            HorizontalOptions="Center" />

                <!-- Song Title -->
                <Label Text="{Binding Song.SongTitle}"
                       FontSize="{StaticResource FontSizeH2}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PlayerText}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       MaxLines="2" />

                <!-- Artist Name -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                        Spacing="{StaticResource Space2}">
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            HeightRequest="24"
                            WidthRequest="24"
                            VerticalOptions="Center"
                            IsVisible="{Binding Song.PersonaImageThumbDisplaySource, Converter={toolkit:IsNotNullConverter}}">
                        <Image Source="{Binding Song.PersonaImageThumbDisplaySource}"
                               Aspect="AspectFill"
                               HeightRequest="24"
                               WidthRequest="24" />
                    </Border>
                    <Label Text="{Binding Song.ArtistName}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           TextColor="{StaticResource PlayerText2}"
                           VerticalOptions="Center"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToArtistCommand}"
                                                  CommandParameter="{Binding Song.ArtistName}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- THE ARTIST PANEL - the web's .playlist-artist-panel. Collapses with its
                     caption when the song has no artist to show, rather than leaving a captioned
                     empty box. -->
                <Border Style="{StaticResource PlayerPanel}"
                        Padding="{StaticResource Space3}"
                        IsVisible="{Binding Source={x:Reference ArtistSection}, Path=HasContent}">
                    <VerticalStackLayout Spacing="{StaticResource Space3}">
                        <Label Style="{StaticResource PlayerPanelCaption}"
                               Text="THE ARTIST" />
                        <views:PersonaSectionView x:Name="ArtistSection"
                                                  PersonaName="{Binding Song.ArtistName}"
                                                  Bio="{Binding Song.PersonaBio}"
                                                  WebsiteUrl="{Binding Song.PersonaWebsiteUrl}"
                                                  ImageSource="{Binding Song.PersonaImageHeroDisplaySource}"
                                                  NavigateCommand="{Binding NavigateToArtistCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Genre · Stream Count · Duration -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                        Spacing="{StaticResource SpaceTight}">
                    <Border Padding="8,4"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{StaticResource PlayerLine}"
                            BackgroundColor="Transparent"
                            IsVisible="{Binding Song.Genre, Converter={toolkit:IsStringNotNullOrEmptyConverter}}">
                        <Label Text="{Binding Song.Genre}"
                               FontSize="{StaticResource FontSizeCardMeta}"
                               TextColor="{StaticResource StBlueBright}"
                               TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToGenreCommand}"
                                                      CommandParameter="{Binding Song.Genre}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Label Text="·"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{StaticResource PlayerText3}"
                           VerticalOptions="Center"
                           IsVisible="{Binding Song.Genre, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />
                          <views:EqualizerPlayButton SongId="{Binding Song.Id}"
                                         Command="{Binding PlaySongCommand}"
                                         ButtonSize="40"
                                         VerticalOptions="Center" />
                    <Label FontSize="{StaticResource FontSizeSmall}"
                           TextColor="{StaticResource PlayerText3}"
                           VerticalOptions="Center">
                        <Label.Text>
                            <Binding Path="Song.StreamCount"
                                     StringFormat="{}{0:N0} streams" />
                        </Label.Text>
                    </Label>
                    <Label Text="·"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{StaticResource PlayerText3}"
                           VerticalOptions="Center" />
                    <Label FontSize="{StaticResource FontSizeSmall}"
                           TextColor="{StaticResource PlayerText3}"
                           VerticalOptions="Center"
                           Text="{Binding Song.TrackLengthSeconds, Converter={StaticResource DurationConverter}}" />
                </HorizontalStackLayout>

                <!-- Subscription Badge (hidden for subscribers) -->
                <Border HorizontalOptions="Center"
                        Padding="12,6"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        IsVisible="{Binding IsCurrentSongPreviewLimited}"
                        BackgroundColor="{StaticResource StAmber}">
                    <Label FontSize="{StaticResource FontSizeCardMeta}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnWarn}"
                           HorizontalTextAlignment="Center"
                           Text="Preview Only (60 seconds)" />
                </Border>

                <!-- Action Row: Like, Dislike, Share -->
                <HorizontalStackLayout HorizontalOptions="Center"
                                        Spacing="{StaticResource Space4}">

                    <!-- Like Button -->
                    <VerticalStackLayout VerticalOptions="Center"
                                         Spacing="{StaticResource SpaceHair}">
                        <Grid HeightRequest="40" WidthRequest="40"
                              HorizontalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LikeSongCommand}" />
                            </Grid.GestureRecognizers>
                            <Path Data="{Binding Song.UserLikeStatus, Converter={StaticResource LikeGlyphConverter}}"
                                  Fill="{Binding Song.UserLikeStatus, Converter={StaticResource LikeFillConverter}}"
                                  Aspect="Uniform"
                                  HeightRequest="24" WidthRequest="24"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding Song.LikeCount}"
                               FontSize="{StaticResource FontSizeMicro}"
                               TextColor="{StaticResource PlayerText3}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Dislike Button -->
                    <VerticalStackLayout VerticalOptions="Center"
                                         Spacing="{StaticResource SpaceHair}">
                        <Grid HeightRequest="40" WidthRequest="40"
                              HorizontalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DislikeSongCommand}" />
                            </Grid.GestureRecognizers>
                            <Path Data="{Binding Song.UserLikeStatus, Converter={StaticResource DislikeGlyphConverter}}"
                                  Fill="{Binding Song.UserLikeStatus, Converter={StaticResource DislikeFillConverter}}"
                                  Aspect="Uniform"
                                  HeightRequest="24" WidthRequest="24"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding Song.DislikeCount}"
                               FontSize="{StaticResource FontSizeMicro}"
                               TextColor="{StaticResource PlayerText3}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Facebook Share Button -->
                    <views:FacebookShareButton ShareUrl="{Binding ShareUrl}"
                                               VerticalOptions="Center" />

                    <!-- Share Button -->
                    <views:ShareButton ShareTitle="{Binding Song.SongTitle}"
                                       ShareUrl="{Binding ShareUrl}"
                                       VerticalOptions="Center" />

                    <!-- Add to Playlist Button -->
                    <views:AddToPlaylistButton SongId="{Binding Song.Id}"
                                               SongTitle="{Binding Song.SongTitle}"
                                               VerticalOptions="Center" />

                    <!-- Tip Button -->
                    <views:TipButton SongId="{Binding Song.Id}"
                                     SongTitle="{Binding Song.SongTitle}"
                                     CreatorId="{Binding Song.CreatorId}"
                                     CreatorUserId="{Binding Song.CreatorUserId}"
                                     VerticalOptions="Center" />

                    <!-- Report Button (hidden offline - reporting needs the server) -->
                    <VerticalStackLayout VerticalOptions="Center"
                                         IsVisible="{Binding CanUseServerActions}"
                                         Spacing="{StaticResource SpaceHair}">
                        <Grid HeightRequest="40" WidthRequest="40"
                              HorizontalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ReportSongCommand}" />
                            </Grid.GestureRecognizers>
                            <Path Data="M3 3v18h2V3H3zm4 0v12h8l-2-6 2-6H7z"
                                  Fill="{StaticResource PlayerText3}"
                                  Aspect="Uniform"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="Report"
                               FontSize="{StaticResource FontSizeNano}"
                               TextColor="{StaticResource PlayerText3}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Now Playing Bar at bottom -->
        <views:NowPlayingView x:Name="NowPlayingBar"
                              CollapseWhenEmpty="False"
                              Grid.Row="1" />
    </Grid>
</ContentPage>
