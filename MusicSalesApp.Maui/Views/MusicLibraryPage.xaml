<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MusicSalesApp.Maui.ViewModels"
             xmlns:views="clr-namespace:MusicSalesApp.Maui.Views"
             x:Class="MusicSalesApp.Maui.Views.MusicLibraryPage"
             x:DataType="vm:MusicLibraryViewModel"
             Title="Music Library"
             HideSoftInputOnTapped="True"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ContentPage.Resources>
        <Style x:Key="FilterSearchContainerStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}" />
        </Style>

        <Style x:Key="FilterSearchEntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
            <Setter Property="ReturnType" Value="Done" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Filter Pill Bar -->
        <VerticalStackLayout Grid.Row="0"
                     Spacing="{StaticResource Space2}"
                     Padding="8,8,8,4">

            <!-- Offline banner. Sits inside the existing Row 0 stack so the grid's row definitions
                 don't have to be renumbered. -->
            <views:InlineWarningBanner IsVisible="{Binding IsOfflineCatalog}"
                                       AutomationId="OfflineLibraryBanner"
                                       Text="You&apos;re offline. Showing only downloaded songs &#8212; reconnect to browse the full library." />

            <!-- Horizontal scroll, not wrap: five pills plus the clear button overflow a narrow
                 phone, and a wrapped second row would push the song list down permanently. -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="{StaticResource SpaceTight}">
            <Border Style="{StaticResource FilterPill}"
                    BackgroundColor="{Binding HasActiveAiFilter, Converter={StaticResource ActivePillBgConverter}}">
                <Border.Stroke>
                    <!-- SolidColorBrush rather than a direct bind: Stroke is a Brush and the converter
                         returns a Color, so the Color goes on the brush where the types already agree. -->
                    <SolidColorBrush Color="{Binding HasActiveAiFilter, Converter={StaticResource ActivePillBorderConverter}}" />
                </Border.Stroke>
                <Label Text="{Binding AiPillText}"
                       Style="{StaticResource FilterPillText}"
                       TextColor="{Binding HasActiveAiFilter, Converter={StaticResource ActivePillTextConverter}}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleAiPanelCommand}" Tapped="OnFilterOptionTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Genre Pill -->
            <Border Style="{StaticResource FilterPill}"
                    BackgroundColor="{Binding HasActiveGenreFilters, Converter={StaticResource ActivePillBgConverter}}">
                <Border.Stroke>
                    <!-- SolidColorBrush rather than a direct bind: Stroke is a Brush and the converter
                         returns a Color, so the Color goes on the brush where the types already agree. -->
                    <SolidColorBrush Color="{Binding HasActiveGenreFilters, Converter={StaticResource ActivePillBorderConverter}}" />
                </Border.Stroke>
                <Label Text="{Binding GenrePillText}"
                       Style="{StaticResource FilterPillText}"
                       TextColor="{Binding HasActiveGenreFilters, Converter={StaticResource ActivePillTextConverter}}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleGenrePanelCommand}" Tapped="OnFilterOptionTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Artist Pill -->
            <Border Style="{StaticResource FilterPill}"
                    BackgroundColor="{Binding HasActiveArtistFilters, Converter={StaticResource ActivePillBgConverter}}">
                <Border.Stroke>
                    <!-- SolidColorBrush rather than a direct bind: Stroke is a Brush and the converter
                         returns a Color, so the Color goes on the brush where the types already agree. -->
                    <SolidColorBrush Color="{Binding HasActiveArtistFilters, Converter={StaticResource ActivePillBorderConverter}}" />
                </Border.Stroke>
                <Label Text="{Binding ArtistPillText}"
                       Style="{StaticResource FilterPillText}"
                       TextColor="{Binding HasActiveArtistFilters, Converter={StaticResource ActivePillTextConverter}}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleArtistPanelCommand}" Tapped="OnFilterOptionTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Title Pill -->
            <Border Style="{StaticResource FilterPill}"
                    BackgroundColor="{Binding HasActiveTitleFilter, Converter={StaticResource ActivePillBgConverter}}">
                <Border.Stroke>
                    <!-- SolidColorBrush rather than a direct bind: Stroke is a Brush and the converter
                         returns a Color, so the Color goes on the brush where the types already agree. -->
                    <SolidColorBrush Color="{Binding HasActiveTitleFilter, Converter={StaticResource ActivePillBorderConverter}}" />
                </Border.Stroke>
                <Label Text="{Binding TitlePillText}"
                       Style="{StaticResource FilterPillText}"
                       TextColor="{Binding HasActiveTitleFilter, Converter={StaticResource ActivePillTextConverter}}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleTitlePanelCommand}" Tapped="OnFilterOptionTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Downloaded-only filter -->
            <Border Style="{StaticResource FilterPill}"
                    BackgroundColor="{Binding IsDownloadedFilterActive, Converter={StaticResource ActivePillBgConverter}}">
                <Border.Stroke>
                    <!-- SolidColorBrush rather than a direct bind: Stroke is a Brush and the converter
                         returns a Color, so the Color goes on the brush where the types already agree. -->
                    <SolidColorBrush Color="{Binding IsDownloadedFilterActive, Converter={StaticResource ActivePillBorderConverter}}" />
                </Border.Stroke>
                <Label Text="Downloaded"
                       Style="{StaticResource FilterPillText}"
                       TextColor="{Binding IsDownloadedFilterActive, Converter={StaticResource ActivePillTextConverter}}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleDownloadedFilterCommand}" Tapped="OnFilterOptionTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Clear Filters Button -->
            <Border Style="{StaticResource FilterPill}"
                    BackgroundColor="{Binding HasAnyActiveFilters, Converter={StaticResource ActivePillBgConverter}}"
                    IsVisible="{Binding HasAnyActiveFilters}"
                    WidthRequest="{StaticResource ControlHeightSmall}"
                    Padding="0">
                <Label Text="✕"
                       Style="{StaticResource FilterPillText}"
                       FontSize="{StaticResource FontSizeSmall}"
                       TextColor="{Binding HasAnyActiveFilters, Converter={StaticResource ActivePillTextConverter}}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ClearFiltersCommand}" Tapped="OnFilterOptionTapped" />
                </Border.GestureRecognizers>
            </Border>
            </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- Expandable Filter Panel -->
        <Border Grid.Row="1"
                IsVisible="{Binding IsAiPanelOpen}"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                Margin="8,0,8,4"
                Padding="8"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}">
            <VerticalStackLayout Spacing="{StaticResource SpaceHair}">
                <Grid ColumnDefinitions="Auto,*" Padding="4,8" ColumnSpacing="{StaticResource Space2}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAiFilterCommand}"
                                              Tapped="OnFilterOptionTapped"
                                              CommandParameter="All" />
                    </Grid.GestureRecognizers>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsAllAiFilterSelected, Mode=OneWay}"
                              Color="{StaticResource Primary}"
                              InputTransparent="True"
                              VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="All Music"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" Padding="4,8" ColumnSpacing="{StaticResource Space2}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAiFilterCommand}"
                                              Tapped="OnFilterOptionTapped"
                                              CommandParameter="AnyAi" />
                    </Grid.GestureRecognizers>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsAnyAiFilterSelected, Mode=OneWay}"
                              Color="{StaticResource Primary}"
                              InputTransparent="True"
                              VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Any AI"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*" Padding="4,8" ColumnSpacing="{StaticResource Space2}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAiFilterCommand}"
                                              Tapped="OnFilterOptionTapped"
                                              CommandParameter="AiMusic" />
                    </Grid.GestureRecognizers>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsAiMusicFilterSelected, Mode=OneWay}"
                              Color="{StaticResource Primary}"
                              InputTransparent="True"
                              VerticalOptions="Center" />
                    <Image Grid.Column="1"
                           Source="music_icon_24.png"
                           HeightRequest="24"
                           WidthRequest="24"
                           Aspect="AspectFit"
                           InputTransparent="True"
                           VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Text="AI Music"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*" Padding="4,8" ColumnSpacing="{StaticResource Space2}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAiFilterCommand}"
                                              Tapped="OnFilterOptionTapped"
                                              CommandParameter="AiVocals" />
                    </Grid.GestureRecognizers>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsAiVocalsFilterSelected, Mode=OneWay}"
                              Color="{StaticResource Primary}"
                              InputTransparent="True"
                              VerticalOptions="Center" />
                    <Image Grid.Column="1"
                           Source="vocals_icon_24.png"
                           HeightRequest="24"
                           WidthRequest="24"
                           Aspect="AspectFit"
                           InputTransparent="True"
                           VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Text="AI Vocals"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*" Padding="4,8" ColumnSpacing="{StaticResource Space2}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAiFilterCommand}"
                                              Tapped="OnFilterOptionTapped"
                                              CommandParameter="AiLyrics" />
                    </Grid.GestureRecognizers>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsAiLyricsFilterSelected, Mode=OneWay}"
                              Color="{StaticResource Primary}"
                              InputTransparent="True"
                              VerticalOptions="Center" />
                    <Image Grid.Column="1"
                           Source="lyrics_icon_24.png"
                           HeightRequest="24"
                           WidthRequest="24"
                           Aspect="AspectFit"
                           InputTransparent="True"
                           VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Text="AI Lyrics"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" Padding="4,8" ColumnSpacing="{StaticResource Space2}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAiFilterCommand}"
                                              Tapped="OnFilterOptionTapped"
                                              CommandParameter="NonAiOnly" />
                    </Grid.GestureRecognizers>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsNonAiOnlyFilterSelected, Mode=OneWay}"
                              Color="{StaticResource Primary}"
                              InputTransparent="True"
                              VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Non-AI Music"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding IsGenrePanelOpen}"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                Margin="8,0,8,4"
                Padding="8"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                MaximumHeightRequest="260">
            <VerticalStackLayout Spacing="{StaticResource Space1}">
                <Border Style="{StaticResource FilterSearchContainerStyle}">
                    <Entry x:Name="GenreSearchEntry"
                           Style="{StaticResource FilterSearchEntryStyle}"
                           Placeholder="Search genres..."
                           Unfocused="OnFilterSearchEntryUnfocused"
                           Text="{Binding GenreSearchText}" />
                </Border>
                <CollectionView ItemsSource="{Binding GenreFilterItems}"
                                SelectionMode="None"
                                MaximumHeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterItem">
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,6" ColumnSpacing="{StaticResource Space2}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnFilterOptionTapped"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=ToggleGenreFilterCommand}"
                                        CommandParameter="{Binding Name}" />
                                </Grid.GestureRecognizers>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Color="{StaticResource Primary}"
                                          InputTransparent="True"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="{StaticResource FontSizeCardTitle}"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding Count}"
                                       FontSize="{StaticResource FontSizeCardMeta}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding IsArtistPanelOpen}"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                Margin="8,0,8,4"
                Padding="8"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                MaximumHeightRequest="260">
            <VerticalStackLayout Spacing="{StaticResource Space1}">
                <Border Style="{StaticResource FilterSearchContainerStyle}">
                    <Entry x:Name="ArtistSearchEntry"
                           Style="{StaticResource FilterSearchEntryStyle}"
                           Placeholder="Search artists..."
                           Unfocused="OnFilterSearchEntryUnfocused"
                           Text="{Binding ArtistSearchText}" />
                </Border>
                <CollectionView ItemsSource="{Binding ArtistFilterItems}"
                                SelectionMode="None"
                                MaximumHeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterItem">
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,6" ColumnSpacing="{StaticResource Space2}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnFilterOptionTapped"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=ToggleArtistFilterCommand}"
                                        CommandParameter="{Binding Name}" />
                                </Grid.GestureRecognizers>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Color="{StaticResource Primary}"
                                          InputTransparent="True"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="{StaticResource FontSizeCardTitle}"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding Count}"
                                       FontSize="{StaticResource FontSizeCardMeta}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Title filter panel. Same Row 1 as the other three, mutually exclusive via IsVisible,
             so no row renumbering. No CollectionView: the typed query is the whole filter. -->
        <Border Grid.Row="1"
                IsVisible="{Binding IsTitlePanelOpen}"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                Margin="8,0,8,4"
                Padding="8"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}">
            <Border Style="{StaticResource FilterSearchContainerStyle}">
                <Entry x:Name="TitleSearchEntry"
                       Style="{StaticResource FilterSearchEntryStyle}"
                       Placeholder="Search titles..."
                       Unfocused="OnFilterSearchEntryUnfocused"
                       Text="{Binding TitleSearchText}" />
            </Border>
        </Border>

        <!-- Song List -->
        <RefreshView x:Name="SongsRefreshView"
                     Grid.Row="2"
                     Command="{Binding LoadSongsCommand}"
                     IsRefreshing="{Binding IsLoading, Mode=OneWay}">
            <!-- No MeasureFirstItem here: SongCardView height varies (AI badge row), so
                 first-item sizing clips the action buttons on taller cards. -->
            <CollectionView ItemsSource="{Binding Songs}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="{StaticResource SpaceTight}"
                                         Padding="20">
                        <Label Text="{Binding EmptyStateTitle}"
                               FontSize="{StaticResource FontSizeH4}"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label Text="{Binding EmptyStateDetail}"
                               FontSize="{StaticResource FontSizeCardTitle}"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label Text="{Binding ErrorMessage}"
                               FontSize="{StaticResource FontSizeCardTitle}"
                               HorizontalTextAlignment="Center"
                               TextColor="Red"
                               IsVisible="{Binding ErrorMessage, Converter={toolkit:IsNotNullConverter}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SongDto">
                        <views:SongCardView
                            OpenSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=OpenSongCommand}"
                            NavigateToArtistCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=NavigateToArtistCommand}"
                            NavigateToGenreCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=NavigateToGenreCommand}"
                            LikeSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=LikeSongCommand}"
                            DislikeSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=DislikeSongCommand}"
                            ReportSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=ReportSongCommand}"
                            ShowReportButton="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=CanUseServerActions}"
                            PlaySongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=PlaySongCommand}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Now Playing Bar (reusable component) -->
        <views:NowPlayingView x:Name="NowPlayingBar"
                              Grid.Row="3" />

    </Grid>

</ContentPage>
