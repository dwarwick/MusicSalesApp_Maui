<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MusicSalesApp.Maui.ViewModels"
             xmlns:views="clr-namespace:MusicSalesApp.Maui.Views"
             x:Class="MusicSalesApp.Maui.Views.MusicLibraryPage"
             x:DataType="vm:MusicLibraryViewModel"
             Title="Music Library"
             HideSoftInputOnTapped="True"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ContentPage.Resources>
        <Style x:Key="FilterSearchContainerStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}" />
        </Style>

        <Style x:Key="FilterSearchEntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
            <Setter Property="ReturnType" Value="Done" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Filter Pill Bar -->
        <VerticalStackLayout Grid.Row="0"
                     Spacing="8"
                     Padding="8,8,8,4">

            <HorizontalStackLayout Spacing="8">
                <Button Command="{Binding ToggleAiPanelCommand}"
                        Clicked="OnFilterChromeClicked"
                        Text="{Binding AiPillText}"
                        FontSize="13"
                        FontAttributes="Bold"
                        HeightRequest="36"
                        Padding="14,0"
                        CornerRadius="18"
                        BackgroundColor="{Binding HasActiveAiFilter, Converter={StaticResource ActivePillBgConverter}}"
                        TextColor="{Binding HasActiveAiFilter, Converter={StaticResource ActivePillTextConverter}}" />

            <!-- Genre Pill -->
            <Button Command="{Binding ToggleGenrePanelCommand}"
                    Clicked="OnFilterChromeClicked"
                    Text="{Binding GenrePillText}"
                    FontSize="13"
                    FontAttributes="Bold"
                    HeightRequest="36"
                    Padding="14,0"
                    CornerRadius="18"
                    BackgroundColor="{Binding HasActiveGenreFilters, Converter={StaticResource ActivePillBgConverter}}"
                    TextColor="{Binding HasActiveGenreFilters, Converter={StaticResource ActivePillTextConverter}}" />

            <!-- Artist Pill -->
            <Button Command="{Binding ToggleArtistPanelCommand}"
                    Clicked="OnFilterChromeClicked"
                    Text="{Binding ArtistPillText}"
                    FontSize="13"
                    FontAttributes="Bold"
                    HeightRequest="36"
                    Padding="14,0"
                    CornerRadius="18"
                    BackgroundColor="{Binding HasActiveArtistFilters, Converter={StaticResource ActivePillBgConverter}}"
                    TextColor="{Binding HasActiveArtistFilters, Converter={StaticResource ActivePillTextConverter}}" />

            <!-- Clear Filters Button -->
            <Button Command="{Binding ClearFiltersCommand}"
                    Clicked="OnFilterChromeClicked"
                    Text="✕"
                    FontSize="14"
                    HeightRequest="36"
                    WidthRequest="36"
                    Padding="0"
                    CornerRadius="18"
                    IsVisible="{Binding HasAnyActiveFilters}"
                    BackgroundColor="{Binding HasAnyActiveFilters, Converter={StaticResource ActivePillBgConverter}}"
                    TextColor="{Binding HasAnyActiveFilters, Converter={StaticResource ActivePillTextConverter}}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Expandable Filter Panel -->
        <Border Grid.Row="1"
                IsVisible="{Binding IsAiPanelOpen}"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                Margin="8,0,8,4"
                Padding="8"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}">
            <VerticalStackLayout Spacing="2">
                <Grid ColumnDefinitions="Auto,*" Padding="4,8" ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAiFilterCommand}"
                                              Tapped="OnFilterOptionTapped"
                                              CommandParameter="All" />
                    </Grid.GestureRecognizers>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsAllAiFilterSelected, Mode=OneWay}"
                              Color="{StaticResource Primary}"
                              InputTransparent="True"
                              VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="All Music"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" Padding="4,8" ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAiFilterCommand}"
                                              Tapped="OnFilterOptionTapped"
                                              CommandParameter="AiOnly" />
                    </Grid.GestureRecognizers>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsAiOnlyFilterSelected, Mode=OneWay}"
                              Color="{StaticResource Primary}"
                              InputTransparent="True"
                              VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="AI Music"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" Padding="4,8" ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAiFilterCommand}"
                                              Tapped="OnFilterOptionTapped"
                                              CommandParameter="NonAiOnly" />
                    </Grid.GestureRecognizers>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsNonAiOnlyFilterSelected, Mode=OneWay}"
                              Color="{StaticResource Primary}"
                              InputTransparent="True"
                              VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Non-AI Music"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding IsGenrePanelOpen}"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                Margin="8,0,8,4"
                Padding="8"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                MaximumHeightRequest="260">
            <VerticalStackLayout Spacing="4">
                <Border Style="{StaticResource FilterSearchContainerStyle}">
                    <Entry x:Name="GenreSearchEntry"
                           Style="{StaticResource FilterSearchEntryStyle}"
                           Placeholder="Search genres..."
                           Unfocused="OnFilterSearchEntryUnfocused"
                           Text="{Binding GenreSearchText}" />
                </Border>
                <CollectionView ItemsSource="{Binding GenreFilterItems}"
                                SelectionMode="None"
                                MaximumHeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterItem">
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,6" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnFilterOptionTapped"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=ToggleGenreFilterCommand}"
                                        CommandParameter="{Binding Name}" />
                                </Grid.GestureRecognizers>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Color="{StaticResource Primary}"
                                          InputTransparent="True"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding Count}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding IsArtistPanelOpen}"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                Margin="8,0,8,4"
                Padding="8"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                MaximumHeightRequest="260">
            <VerticalStackLayout Spacing="4">
                <Border Style="{StaticResource FilterSearchContainerStyle}">
                    <Entry x:Name="ArtistSearchEntry"
                           Style="{StaticResource FilterSearchEntryStyle}"
                           Placeholder="Search artists..."
                           Unfocused="OnFilterSearchEntryUnfocused"
                           Text="{Binding ArtistSearchText}" />
                </Border>
                <CollectionView ItemsSource="{Binding ArtistFilterItems}"
                                SelectionMode="None"
                                MaximumHeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterItem">
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,6" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnFilterOptionTapped"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=ToggleArtistFilterCommand}"
                                        CommandParameter="{Binding Name}" />
                                </Grid.GestureRecognizers>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Color="{StaticResource Primary}"
                                          InputTransparent="True"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding Count}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Song List -->
        <RefreshView x:Name="SongsRefreshView"
                     Grid.Row="2"
                     Command="{Binding LoadSongsCommand}"
                     IsRefreshing="{Binding IsLoading, Mode=OneWay}">
            <CollectionView ItemsSource="{Binding Songs}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="20">
                        <Label Text="No songs available"
                               FontSize="18"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label Text="{Binding ErrorMessage}"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="Red"
                               IsVisible="{Binding ErrorMessage, Converter={toolkit:IsNotNullConverter}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SongDto">
                        <views:SongCardView
                            OpenSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=OpenSongCommand}"
                            NavigateToArtistCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=NavigateToArtistCommand}"
                            NavigateToGenreCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=NavigateToGenreCommand}"
                            LikeSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=LikeSongCommand}"
                            DislikeSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=DislikeSongCommand}"
                            ReportSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=ReportSongCommand}"
                            PlaySongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicLibraryViewModel}}, Path=PlaySongCommand}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Now Playing Bar (reusable component) -->
        <views:NowPlayingView x:Name="NowPlayingBar"
                              Grid.Row="3" />

    </Grid>

</ContentPage>
