<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:vm="clr-namespace:MusicSalesApp.Maui.ViewModels"
             xmlns:views="clr-namespace:MusicSalesApp.Maui.Views"
             x:Class="MusicSalesApp.Maui.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Home"
             SafeAreaEdges="Container"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0" Padding="0">

            <!-- ========== FEATURED MUSIC ========== -->
            <VerticalStackLayout IsVisible="{Binding ShowFeaturedMusic}"
                                 Padding="20,0,20,0"
                                 Spacing="0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Text="Featured Music"
                           FontSize="22"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#1a1a2e, Dark=White}" />
                    <Label Grid.Column="1"
                           Text="View All ›"
                           FontSize="14"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="End"
                           TextColor="{StaticResource Primary}"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToMusicLibraryCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Label Text="{Binding SubscriptionAccessText}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#b3b3b3}" />

                <!-- No MeasureFirstItem here: SongCardView size varies (AI badge row), so
                     first-item sizing clips the action buttons on larger cards. -->
                <CollectionView ItemsSource="{Binding FeaturedSongs}"
                                SelectionMode="None"
                                HeightRequest="400"
                                HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="0" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SongDto">
                            <views:SongCardView OpenSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenSongCommand}"
                                                NavigateToArtistCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=NavigateToArtistCommand}"
                                                NavigateToGenreCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=NavigateToGenreCommand}"
                                                LikeSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=LikeSongCommand}"
                                                DislikeSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=DislikeSongCommand}"
                                                ReportSongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=ReportSongCommand}"
                                                ShowReportButton="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=CanUseServerActions}"
                                                PlaySongCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=PlaySongCommand}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- ========== HERO SECTION ========== -->
            <VerticalStackLayout Padding="24,4,24,4" Spacing="2"
                  BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

                <!-- Title row: text + Lottie, wraps like flex-row -->
                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="Discover your"
                               FontSize="24"
                               FontAttributes="Bold"
                               LineBreakMode="NoWrap"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="next favorite artist!"
                               FontSize="20"
                               FontAttributes="Bold"
                               LineBreakMode="NoWrap"
                               TextColor="{AppThemeBinding Light=#1a1a2e, Dark=White}" />
                    </VerticalStackLayout>

                    <skia:SKLottieView Source="hero_animation.json"
                                       RepeatCount="-1"
                                       RepeatMode="Restart"
                                       HeightRequest="135"
                                       WidthRequest="135" />
                </FlexLayout>

                <views:SubscriptionInfoUnavailableBanner
                    IsVisible="{Binding ShowSubscriptionUnavailableBanner}"
                    Text="{Binding SubscriptionUnavailableBannerText}"
                    Margin="0,8,0,0" />

                <!-- CTA: Not logged in -->
                <HorizontalStackLayout Spacing="12"
                                       IsVisible="{Binding ShowLoginRegister}"
                                       Margin="0,8,0,0">
                    <Button Text="Log In"
                            Command="{Binding NavigateToLoginCommand}"
                            BackgroundColor="#8e44ad"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            HeightRequest="44"
                            MinimumWidthRequest="100"
                            Padding="20,0" />
                    <Button Text="Register"
                            Command="{Binding NavigateToRegisterCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            HeightRequest="44"
                            MinimumWidthRequest="100"
                            Padding="20,0" />
                </HorizontalStackLayout>

                <!-- CTA: Logged in, email not verified -->
                <Button Text="Validate Your Email"
                        Command="{Binding NavigateToValidateEmailCommand}"
                        IsVisible="{Binding ShowValidateEmail}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="24"
                        HeightRequest="44"
                        HorizontalOptions="Start"
                        Padding="20,0"
                        Margin="0,8,0,0" />

                    <views:SubscriptionOfferCardView IsVisible="{Binding ShowSubscriptionOfferCard}"
                                                     Margin="0,8,0,0"
                                                     TitleText="{Binding SubscriptionOfferTitleText}"
                                                     BodyText="{Binding SubscriptionOfferBodyText}"
                                                     PriceText="{Binding SubscriptionOfferPriceText}"
                                                     ShowPriceText="{Binding ShowSubscriptionOfferPriceText}"
                                                     DisclosureText="{Binding SubscriptionOfferDisclosureText}"
                                                     PrimaryButtonText="{Binding SubscriptionOfferPrimaryButtonText}"
                                                     PrimaryCommand="{Binding SubscriptionOfferPrimaryCommand}"
                                                     ShowPrimaryButton="{Binding ShowSubscriptionOfferPrimaryButton}"
                                                     SecondaryButtonText="Log In"
                                                     SecondaryCommand="{Binding SubscriptionOfferSecondaryCommand}"
                                                     ShowSecondaryButton="{Binding ShowSubscriptionOfferSecondaryButton}" />

                <!-- CTA: Logged in, verified, no subscription -->
                <Button Text="{Binding SubscribeButtonText}"
                        Command="{Binding SubscribeCommand}"
                        IsVisible="{Binding ShowSubscribeNow}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="24"
                        HeightRequest="44"
                        HorizontalOptions="Start"
                        Padding="20,0"
                        Margin="0,8,0,0" />

                <!-- CTA: Has active subscription -->
                <Button Text="Browse Music"
                        Command="{Binding NavigateToMusicLibraryCommand}"
                        IsVisible="{Binding ShowBrowseMusic}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="24"
                        HeightRequest="44"
                        HorizontalOptions="Start"
                        Padding="20,0"
                        Margin="0,8,0,0" />

            </VerticalStackLayout>

            <!-- ========== YOUR PLAYLISTS (authenticated + email verified) ========== -->
            <VerticalStackLayout IsVisible="{Binding ShowPlaylists}"
                                 Padding="20,24,20,0"
                                 Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Text="Your Playlists"
                           FontSize="22"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#1a1a2e, Dark=White}" />
                    <Label Grid.Column="1"
                           Text="My Playlists ›"
                           FontSize="14"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="End"
                           TextColor="{StaticResource Primary}"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToMyPlaylistsCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Recommended tile -->
                <Border IsVisible="{Binding ShowRecommended}"
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2a2a2a}"
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenRecommendedCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                WidthRequest="56" HeightRequest="56"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource Primary}"
                                Stroke="Transparent">
                            <Label Text="★"
                                   FontSize="28"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding RecommendedPlaylist.Name}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1a1a2e, Dark=White}" />
                            <Label Text="{Binding RecommendedPlaylist.SongCount, StringFormat='{0} songs'}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#b3b3b3}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="▶"
                               FontSize="24"
                               TextColor="{StaticResource Primary}"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Liked Songs tile -->
                <Border IsVisible="{Binding ShowLikedSongs}"
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2a2a2a}"
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPlaylistCommand}"
                                              CommandParameter="{Binding LikedSongsPlaylist}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                WidthRequest="56" HeightRequest="56"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="#e74c3c"
                                Stroke="Transparent">
                            <Label Text="♥"
                                   FontSize="28"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding LikedSongsPlaylist.Name}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1a1a2e, Dark=White}" />
                            <Label Text="{Binding LikedSongsPlaylist.SongCount, StringFormat='{0} songs'}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#b3b3b3}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="▶"
                               FontSize="24"
                               TextColor="{StaticResource Primary}"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ========== WHY STREAMTUNES SECTION ========== -->
            <VerticalStackLayout IsVisible="{Binding ShowSubscriptionContent}" Padding="20,32,20,32" Spacing="20">

                <Label Text="Why StreamTunes?"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#1a1a2e, Dark=White}" />

                <!-- Feature Card 1: Unlimited Streaming -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2a2a2a}"
                        Padding="24">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#00000014, Dark=#00000066}"
                                Offset="0,4"
                                Radius="20" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border WidthRequest="72" HeightRequest="72"
                                StrokeShape="RoundRectangle 36"
                                BackgroundColor="{StaticResource Primary}"
                                Stroke="Transparent"
                                HorizontalOptions="Center">
                            <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                  Fill="White" Aspect="Uniform"
                                  HeightRequest="32" WidthRequest="32"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Unlimited Streaming"
                               FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#1a1a2e, Dark=White}" />
                        <Label Text="Access our entire catalog of songs with no limits. Play any track, any time, as many times as you want."
                               FontSize="14" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#b3b3b3}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Feature Card 2: Personal Playlists -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2a2a2a}"
                        Padding="24">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#00000014, Dark=#00000066}"
                                Offset="0,4"
                                Radius="20" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border WidthRequest="72" HeightRequest="72"
                                StrokeShape="RoundRectangle 36"
                                BackgroundColor="{StaticResource Primary}"
                                Stroke="Transparent"
                                HorizontalOptions="Center">
                            <Label Text="&#x2764;" FontSize="32" TextColor="White"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Label Text="Personal Playlists"
                               FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#1a1a2e, Dark=White}" />
                        <Label Text="Create custom playlists, like your favorite songs, and get personalized recommendations based on your taste."
                               FontSize="14" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#b3b3b3}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Feature Card 3: Cancel Anytime -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2a2a2a}"
                        Padding="24">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#00000014, Dark=#00000066}"
                                Offset="0,4"
                                Radius="20" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border WidthRequest="72" HeightRequest="72"
                                StrokeShape="RoundRectangle 36"
                                BackgroundColor="{StaticResource Primary}"
                                Stroke="Transparent"
                                HorizontalOptions="Center">
                            <Label Text="&#x1F4B3;" FontSize="32" TextColor="White"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Label Text="Cancel Anytime"
                               FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#1a1a2e, Dark=White}" />
                        <Label Text="No contracts, no commitments. Your subscription renews monthly and you can cancel whenever you want."
                               FontSize="14" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#b3b3b3}" />
                        <Label Text="{Binding ManageSubscriptionText}"
                               IsVisible="{Binding ShowManageSubscriptionLink}"
                               FontSize="13"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Primary}"
                               TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSubscriptionManagementCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <views:NowPlayingView x:Name="NowPlayingBar"
                              Grid.Row="1" />
    </Grid>

</ContentPage>
