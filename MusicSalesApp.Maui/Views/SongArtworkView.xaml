<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="MusicSalesApp.Maui.Views.SongArtworkView"
             x:Name="Root">
    <Grid InputTransparent="True">
        <Image Source="{Binding AlbumArtUrl, Source={x:Reference Root}}"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="{Binding HasAlbumArt, Source={x:Reference Root}}" />

        <skia:SKLottieView Source="hero_animation.json"
                           RepeatCount="-1"
                           RepeatMode="Restart"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           IsVisible="{Binding HasFallbackArtwork, Source={x:Reference Root}}" />
    </Grid>
</ContentView>
