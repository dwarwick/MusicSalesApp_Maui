<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicSalesApp.Maui.Views.SongArtworkView"
             x:Name="Root">
    <Grid InputTransparent="True">
        <Image Source="{Binding AlbumArtUrl, Source={x:Reference Root}}"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="{Binding HasAlbumArt, Source={x:Reference Root}}" />

        <Grid IsVisible="{Binding HasFallbackArtwork, Source={x:Reference Root}}"
              BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
            <Image Source="music_icon_24.png"
                   Aspect="AspectFit"
                   HeightRequest="48"
                   WidthRequest="48"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentView>
