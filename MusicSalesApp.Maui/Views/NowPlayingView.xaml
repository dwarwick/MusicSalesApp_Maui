<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MusicSalesApp.Maui.Views"
             x:Class="MusicSalesApp.Maui.Views.NowPlayingView">

    <!-- Colours are applied in code, from OnDarkSurface. On the player pages this bar is the
         player's own surface and is dark in either OS theme - the web paints
         .song-player-container .player-bar the same rgba(13,23,39,.92) in light.css and dark.css.
         Everywhere else it is page chrome and follows the OS theme, which is also how the web
         scopes it. The values set here are only the dark ones; ApplySurface overwrites them. -->
    <Grid x:Name="DrawerRoot"
                    MinimumHeightRequest="{StaticResource ControlHeight}">
        <!-- ROUNDED ENDS, matching the web's .player-bar: a pill with a hairline edge, floated off
             the screen sides by its margin so the ends actually read as ends rather than being
             clipped flat against the display.

             The radius is a fixed 28 rather than the pill token. This bar is a DRAWER - it grows
             when expanded - and a pill radius resolves against half the height, so an expanded bar
             would round into a stadium. 28 is a true pill at the collapsed height and stays a
             sensible large round once open. -->
        <Border x:Name="PlayerBorder"
                Padding="0"
                Margin="{StaticResource Space2}, 0, {StaticResource Space2}, {StaticResource Space2}"
                StrokeShape="RoundRectangle 28"
                BackgroundColor="{StaticResource PlayerBarDark}"
                Stroke="{StaticResource PlayerLineStrong}"
                StrokeThickness="{StaticResource StrokeThin}">
            <VerticalStackLayout Spacing="0">
                <VerticalStackLayout x:Name="ExpandedContent"
                                                                         Spacing="0">
                    <VerticalStackLayout x:Name="SongContentContainer"
                                         Spacing="0">
                        <!-- Progress Slider Row -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="{StaticResource Space2}"
                              Padding="12,8,12,0">
                            <Label Grid.Column="0"
                                   x:Name="PositionLabel"
                                   Text="0:00"
                                   FontSize="{StaticResource FontSizeMicro}"
                                   TextColor="{StaticResource TimeText}"
                                   VerticalOptions="Center" />
                            <Grid Grid.Column="1"
                                  VerticalOptions="Center">
                                <Slider x:Name="ProgressSlider"
                                        Minimum="0"
                                        Maximum="1"
                                        MinimumTrackColor="{StaticResource Primary}"
                                        MaximumTrackColor="{StaticResource ProgressTrack}"
                                        ThumbColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                <!-- CornerRadius is off-scale on purpose: a 1px round on a 3px marker, not a surface radius. -->
                                <BoxView x:Name="PreviewMarker"
                                         WidthRequest="3"
                                         HeightRequest="20"
                                         Color="{StaticResource StAmber}"
                                         CornerRadius="1"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Start"
                                         IsVisible="False"
                                         InputTransparent="True"
                                         ZIndex="2" />
                            </Grid>
                            <Label Grid.Column="2"
                                   x:Name="DurationLabel"
                                   Text="0:00"
                                   FontSize="{StaticResource FontSizeMicro}"
                                   TextColor="{StaticResource TimeText}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- The art, title and artist are ONE hit target: tapping any of them
                             scrolls the list behind the bar to the playing song. The gesture sits on
                             the Grid rather than on each child so the gap between them is live too.
                             SongArtworkView's root is InputTransparent, so the artwork Border below
                             does not swallow the touch. -->
                        <Grid ColumnDefinitions="36,*"
                              ColumnSpacing="{StaticResource Space2}"
                              Padding="12,4,12,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer x:Name="SongInfoTap" />
                            </Grid.GestureRecognizers>
                            <Border StrokeShape="RoundRectangle 4"
                                    StrokeThickness="0"
                                    HeightRequest="{StaticResource ArtSizeMini}"
                                    WidthRequest="{StaticResource ArtSizeMini}">
                                <views:SongArtworkView x:Name="AlbumArtworkView"
                                                       HeightRequest="{StaticResource ArtSizeMini}"
                                                       WidthRequest="{StaticResource ArtSizeMini}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="0">
                                <Label x:Name="SongTitleLabel"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PlayerText}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label x:Name="ArtistNameLabel"
                                       FontSize="{StaticResource FontSizeMicro}"
                                       TextColor="{StaticResource PlayerText2}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="EmptyStateContainer"
                                         Spacing="{StaticResource Space1}"
                                         Padding="12,8,12,0"
                                         IsVisible="False">
                        <Label x:Name="EmptyStateTitleLabel"
                               Text="Nothing queued yet"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PlayerText}" />
                        <Label x:Name="EmptyStateHintLabel"
                               Text="Press Play to start listening from this screen."
                               FontSize="{StaticResource FontSizeMicro}"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource PlayerText2}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="{StaticResource Space3}"
                                           HorizontalOptions="Center"
                                           Padding="12,2,12,6"
                                           InputTransparent="False">

                        <Border x:Name="ShuffleBorder"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="0"
                                HeightRequest="{StaticResource ControlHeightSmall}"
                                WidthRequest="{StaticResource ControlHeightSmall}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center">
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer x:Name="ShuffleTap" />
                                </Grid.GestureRecognizers>
                                <Path x:Name="ShuffleIcon"
                                      Data="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z"
                                      Aspect="Uniform"
                                      HeightRequest="18"
                                      WidthRequest="18"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="PrevBorder"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="0"
                                HeightRequest="{StaticResource ControlHeightSmall}"
                                WidthRequest="{StaticResource ControlHeightSmall}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                IsVisible="False">
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer x:Name="PrevTap" />
                                </Grid.GestureRecognizers>
                                <Path x:Name="PrevIcon"
                                      Data="M6 6h2v12H6zm3.5 6l8.5 6V6z"
                                      Fill="{StaticResource PlayerText}"
                                      Aspect="Uniform"
                                      HeightRequest="18"
                                      WidthRequest="18"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="PlayPauseBorder"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                HeightRequest="40"
                                WidthRequest="40"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center">
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer x:Name="PlayPauseTap" />
                                </Grid.GestureRecognizers>
                                <Path x:Name="PlayPauseIcon"
                                      Fill="{StaticResource PlayerText}"
                                      Aspect="Uniform"
                                      HeightRequest="18"
                                      WidthRequest="18"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="NextBorder"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="0"
                                HeightRequest="{StaticResource ControlHeightSmall}"
                                WidthRequest="{StaticResource ControlHeightSmall}"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                IsVisible="False">
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer x:Name="NextTap" />
                                </Grid.GestureRecognizers>
                                <Path x:Name="NextIcon"
                                      Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"
                                      Fill="{StaticResource PlayerText}"
                                      Aspect="Uniform"
                                      HeightRequest="18"
                                      WidthRequest="18"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="RepeatBorder"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                HeightRequest="40"
                                WidthRequest="40"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center">
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer x:Name="RepeatTap" />
                                </Grid.GestureRecognizers>
                                <Path x:Name="RepeatIcon"
                                      Data="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"
                                      Aspect="Uniform"
                                      HeightRequest="20"
                                      WidthRequest="20"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
