<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MusicSalesApp.Maui.ViewModels"
             xmlns:views="clr-namespace:MusicSalesApp.Maui.Views"
             x:Class="MusicSalesApp.Maui.Views.AccountSettingsPage"
             x:DataType="vm:AccountSettingsViewModel"
             Title="Account Settings"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <Grid>
        <!-- Main content -->
        <ScrollView>
            <VerticalStackLayout Padding="24,24" Spacing="{StaticResource Space5}">

                <!-- Account Info -->
                <VerticalStackLayout Spacing="{StaticResource Space1}">
                    <Label Text="Account"
                           FontSize="{StaticResource FontSizeH2Compact}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                    <Label Text="{Binding UserEmail}"
                           FontSize="{StaticResource FontSizeBody}"
                           TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                </VerticalStackLayout>

                <!-- Divider -->
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

                <!-- Subscription Section -->
                <VerticalStackLayout Spacing="{StaticResource Space3}">
                    <Label Text="Subscription"
                           FontSize="{StaticResource FontSizeH4}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                    <views:InlineWarningBanner
                        AutomationId="SubscriptionInfoUnavailableBanner"
                        IsVisible="{Binding ShowSubscriptionUnavailableBanner}"
                        Text="{Binding SubscriptionUnavailableBannerText}" />
                    <Label Text="{Binding SubscriptionStatusText}"
                           FontSize="{StaticResource FontSizeBody}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                    <Label Text="{Binding SubscriptionStatusMessage}"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                    <Label Text="{Binding SubscriptionEndDateText}"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                           IsVisible="{Binding ShowSubscriptionEndDate}" />
                    <Label Text="{Binding BillingSourceText}"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}"
                           IsVisible="{Binding ShowBillingSource}" />
                    <Button Text="Cancel Subscription"
                            Command="{Binding CancelSubscriptionCommand}"
                            IsVisible="{Binding ShowCancelSubscription}"
                            IsEnabled="{Binding IsCancelling, Converter={toolkit:InvertedBoolConverter}}"
                            BackgroundColor="{StaticResource DangerLight}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="{StaticResource RadiusSmInt}"
                            HeightRequest="{StaticResource ControlHeight}"
                            HorizontalOptions="Start"
                            Padding="20,0" />
                    <views:SubscriptionOfferCardView IsVisible="{Binding ShowSubscriptionOfferCard}"
                                                     TitleText="{Binding SubscriptionOfferTitleText}"
                                                     BodyText="{Binding SubscriptionOfferBodyText}"
                                                     PriceText="{Binding SubscriptionOfferPriceText}"
                                                     ShowPriceText="{Binding ShowSubscriptionOfferPriceText}"
                                                     DisclosureText="{Binding SubscriptionOfferDisclosureText}"
                                                     PrimaryButtonText="{Binding SubscribeButtonText}"
                                                     PrimaryCommand="{Binding SubscribeCommand}"
                                                     IsPrimaryButtonEnabled="{Binding IsSubscriptionOfferPrimaryButtonEnabled}"
                                                     ShowPrimaryButton="True" />
                         <Button Text="{Binding SubscribeButtonText}"
                                Command="{Binding SubscribeCommand}"
                                IsVisible="{Binding ShowPlainSubscribeButton}"
                                IsEnabled="{Binding IsSubscribing, Converter={toolkit:InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource AccentFillLight}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="{StaticResource RadiusSmInt}"
                                HeightRequest="{StaticResource ControlHeight}"
                                HorizontalOptions="Start"
                                Padding="20,0" />
                         <ActivityIndicator IsRunning="{Binding IsSubscribing}"
                                          IsVisible="{Binding IsSubscribing}"
                                          Color="{StaticResource AccentFillLight}"
                                          HorizontalOptions="Start" />

                    <!-- Divider -->
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                </VerticalStackLayout>

                <!-- Sign-In Section. Hidden where the device has no biometrics enrolled, on either platform. -->
                <VerticalStackLayout Spacing="{StaticResource Space3}"
                                     IsVisible="{Binding IsBiometricLoginSupported}">
                    <Label Text="Sign-In"
                           FontSize="{StaticResource FontSizeH4}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                    <Label Text="{Binding BiometricLoginStatusText}"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
                    <Button Text="{Binding TurnOffBiometricLoginText}"
                            Command="{Binding TurnOffBiometricLoginCommand}"
                            IsVisible="{Binding IsBiometricLoginEnabled}"
                            BackgroundColor="{StaticResource GenreFillLight}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="{StaticResource RadiusSmInt}"
                            HeightRequest="{StaticResource ControlHeight}"
                            HorizontalOptions="Start"
                            Padding="20,0" />

                    <!-- Divider -->
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                </VerticalStackLayout>

                <!-- Delete Account Section -->
                <VerticalStackLayout Spacing="{StaticResource Space3}">
                    <Label Text="Delete Account"
                           FontSize="{StaticResource FontSizeH4}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource DangerLight}" />

                    <!-- Warning box -->
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource DangerLight}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoftLight}, Dark={StaticResource DangerSoftDark}}"
                            Padding="16">
                        <VerticalStackLayout Spacing="{StaticResource Space2}">
                            <Label Text="⚠ Warning"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource DangerLight}" />
                            <Label Text="• All your account data including playlists and subscription records will be permanently deleted."
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            <Label Text="• If you create a new account later, your deleted playlists and preferences will not be restored."
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            <Label Text="• This action cannot be undone!"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource DangerLight}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Active subscription blocking message -->
                    <Label Text="You must cancel your active subscription before deleting your account."
                           FontSize="{StaticResource FontSizeCardTitle}"
                           FontAttributes="Italic"
                           TextColor="{StaticResource DangerLight}"
                           IsVisible="{Binding ShowCancelSubscription}" />

                    <Label Text="If you are an active creator, you must stop being a creator on the website before deleting your account."
                           FontSize="{StaticResource FontSizeCardTitle}"
                           FontAttributes="Italic"
                           TextColor="{StaticResource DangerLight}"
                           IsVisible="{Binding ShowCreatorDeletionBlockedMessage}" />

                    <Button Text="Delete My Account"
                            Command="{Binding ShowDeleteAccountPromptCommand}"
                            IsEnabled="{Binding CanDeleteAccount}"
                            BackgroundColor="{StaticResource DangerLight}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="{StaticResource RadiusSmInt}"
                            HeightRequest="{StaticResource ControlHeight}"
                            HorizontalOptions="Start"
                            Padding="20,0" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Delete Confirmation Overlay -->
        <Grid IsVisible="{Binding ShowDeleteConfirmation}"
              BackgroundColor="{StaticResource Scrim}">
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Padding="24"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="400"
                    Margin="24">
                <VerticalStackLayout Spacing="{StaticResource Space4}">
                    <Label Text="Confirm Account Deletion"
                           FontSize="{StaticResource FontSizeH3}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource DangerLight}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="This will permanently delete your account and all associated data. Type DELETE below to confirm."
                           FontSize="{StaticResource FontSizeCardTitle}"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                           HorizontalTextAlignment="Center" />

                    <Entry Placeholder="Type DELETE to confirm"
                           Text="{Binding ConfirmationText}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           HorizontalTextAlignment="Center"
                           BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHoverLight}, Dark={StaticResource SurfaceHoverDark}}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Text3Light}, Dark={StaticResource Text3Dark}}" />

                    <!-- Error message -->
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextColor="{StaticResource DangerLight}"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding ErrorMessage, Converter={toolkit:IsNotNullOrEmptyConverter}}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space3}">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                Command="{Binding CancelDeleteCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                                FontAttributes="Bold"
                                CornerRadius="{StaticResource RadiusSmInt}"
                                HeightRequest="{StaticResource ControlHeight}" />
                        <Button Grid.Column="1"
                                Text="Delete"
                                Command="{Binding ConfirmDeleteCommand}"
                                IsEnabled="{Binding CanConfirmDelete}"
                                BackgroundColor="{StaticResource DangerLight}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="{StaticResource RadiusSmInt}"
                                HeightRequest="{StaticResource ControlHeight}" />
                    </Grid>

                    <!-- Deleting indicator -->
                    <ActivityIndicator IsRunning="{Binding IsDeleting}"
                                       IsVisible="{Binding IsDeleting}"
                                       Color="{StaticResource DangerLight}"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
