        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>

    <!-- ===================================================================
         NAMED COMPONENT STYLES
         The recipes below were previously copy-pasted attribute-by-attribute across pages:
         the pill button appeared in five files, the filter pill four times verbatim inside
         one file, and all five auth pages open with an identical form shell. Each is here
         once now. Adding a sixth caller should mean adding a Style attribute, not another
         six attributes.
         =================================================================== -->

    <!-- Primary action. Blue fill, and the label colour comes from the On* family so dark
         gets a near-black label on a bright fill rather than white on blue. -->
    <Style TargetType="Button" x:Key="PillButtonPrimary">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPillControlInt}" />
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource PillPadding}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Secondary action. Violet, reserved for account and creator routes exactly as the web
         app reserves it, so the two clients agree on what violet means. -->
    <Style TargetType="Button" x:Key="PillButtonSecondary">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GenreFillLight}, Dark={StaticResource GenreFillDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnGenreLight}, Dark={StaticResource OnGenreDark}}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPillControlInt}" />
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource PillPadding}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Ghost action. Transparent with a hairline, for the row of icon actions on a card. -->
    <Style TargetType="Button" x:Key="GhostButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
        <Setter Property="BorderWidth" Value="{StaticResource StrokeThin}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmInt}" />
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeightSmall}" />
    </Style>

    <!-- The primary button on the five auth pages: full width, taller than a pill. -->
    <Style TargetType="Button" x:Key="AuthPrimaryButton" BasedOn="{StaticResource PillButtonPrimary}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmInt}" />
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeightLarge}" />
    </Style>

    <!-- Filter pill, inactive. MusicLibraryPage repeated this ten-property recipe four times.
         The active state is a separate style rather than a trigger because the pages drive it
         through converters today; converting those to VisualStates is a later, separate job.

         Border and Label, NOT Button - the same reason the player's segmented switch is. A UIButton
         whose layer corner radius is the pill 999 does not paint its fill on iOS, so the whole row
         of pills came up as bare text with no fill and no outline. Anything wearing the pill shape
         has to be drawn by a Border, which clamps the shape to its own bounds. -->
    <Style TargetType="Border" x:Key="FilterPill">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <!-- ControlLine*, not Line*: a pill is an interactive control, and Line* is 1.30:1 on the
             surface it sits on. At that ratio the outline reads as absent - which is how this
             shipped, invisible on a light page. -->
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ControlLineLight}, Dark={StaticResource ControlLineDark}}" />
        <Setter Property="StrokeThickness" Value="{StaticResource StrokeThick}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeightSmall}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Border" x:Key="FilterPillActive" BasedOn="{StaticResource FilterPill}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}" />
    </Style>

    <!-- The pill's label. Split out of the style above for the same reason the switch's is: the
         fill is on the Border and the foreground here, and the two move together. -->
    <Style TargetType="Label" x:Key="FilterPillText">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCardMeta}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="FilterPillTextActive" BasedOn="{StaticResource FilterPillText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
    </Style>

    <!-- A card is RAISED in both themes: the dark surface is lighter than the dark page, and
         the shadow is dark in both. Do not add a light-theme-only shadow. -->
    <Style TargetType="Border" x:Key="CardSurface">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeThickness" Value="{StaticResource StrokeThin}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Shadow" Value="{StaticResource ShadowCard}" />
    </Style>

    <!-- Panels on the player pages. Flat player tokens, never the themed pair: the player is
         dark under a light OS theme too. The reason is measured rather than stylistic - the
         accent that carries the sung word is 8.60:1 on this surface and about 2.1:1 on white, so
         a light player would need a different accent and the moment the design is built around
         would change with an OS preference. -->
    <Style TargetType="Border" x:Key="PlayerPanel">
        <Setter Property="BackgroundColor" Value="{StaticResource PlayerSurface}" />
        <Setter Property="Stroke" Value="{StaticResource PlayerLine}" />
        <Setter Property="StrokeThickness" Value="{StaticResource StrokeThin}" />
        <Setter Property="Padding" Value="{StaticResource Space4}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>

    <!-- The label above each panel. Uppercase and tracked out, which is what makes a caption read
         as a caption at this size rather than as very small body text. -->
    <Style TargetType="Label" x:Key="PlayerPanelCaption">
        <Setter Property="TextColor" Value="{StaticResource PlayerText3}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Segmented switch inside a panel header. Inactive segments are quiet; the active one takes
         the BRIGHT fill with a near-black glyph, which is the same pairing the play button uses
         and the strongest available on this surface.

         Border and Label, NOT Button. A UIButton whose layer corner radius is the pill 999 does
         not paint its fill on iOS, and the active segment's near-black label was then sitting
         straight on the panel and invisible - the label recoloured, the fill never arrived. The
         genre chip beside it is this same Border-and-Label recipe with the same 999 shape and has
         always drawn correctly, so the shape is fine and the control was not. -->
    <Style TargetType="Border" x:Key="PlayerSwitchTrack">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="{StaticResource PlayerLine}" />
        <Setter Property="StrokeThickness" Value="{StaticResource StrokeThin}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Border" x:Key="PlayerSwitchSegment">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style TargetType="Border" x:Key="PlayerSwitchSegmentActive" BasedOn="{StaticResource PlayerSwitchSegment}">
        <Setter Property="BackgroundColor" Value="{StaticResource StBlueBright}" />
    </Style>

    <!-- The two halves of the state: the fill above, the label here. Both move together, because
         a bright fill under a quiet label, or a near-black label with no fill, is unreadable. -->
    <Style TargetType="Label" x:Key="PlayerSwitchSegmentText">
        <Setter Property="TextColor" Value="{StaticResource PlayerText3}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="PlayerSwitchSegmentTextActive" BasedOn="{StaticResource PlayerSwitchSegmentText}">
        <Setter Property="TextColor" Value="{StaticResource OnAccentDark}" />
    </Style>

    <!-- Body text on a player panel. -->
    <Style TargetType="Label" x:Key="PlayerBodyText">
        <Setter Property="TextColor" Value="{StaticResource PlayerText2}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>

    <!-- Text roles. Three weights of emphasis, matching the web's text / text-2 / text-3. -->
    <Style TargetType="Label" x:Key="SectionHeading">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeH2}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Label" x:Key="SecondaryText">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text2Light}, Dark={StaticResource Text2Dark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>

    <!-- Text3 is the DIMMEST that still passes AA in each theme. Nothing quieter than this. -->
    <Style TargetType="Label" x:Key="MicroText">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text3Light}, Dark={StaticResource Text3Dark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
    </Style>

    <Style TargetType="Label" x:Key="ErrorText">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>

    <!-- A tappable text link. -->
    <Style TargetType="Label" x:Key="LinkText">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- The shell every auth page opens with. -->
    <Style TargetType="VerticalStackLayout" x:Key="AuthFormLayout">
        <Setter Property="Spacing" Value="{StaticResource Space4}" />
        <Setter Property="Padding" Value="{StaticResource AuthFormPadding}" />
        <Setter Property="MaximumWidthRequest" Value="400" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

</ResourceDictionary>
