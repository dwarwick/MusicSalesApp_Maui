    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="15" />
        <Setter Property="Opacity" Value="0.5" />
        <!-- A SHADOW IS ALWAYS DARK, IN BOTH THEMES (Tokens.xaml elevation note, AGENTS.md
             invariant 4). This stock template style shipped white in both, which reads as a halo
             rather than as height for any inline <Shadow> that does not set Brush itself. -->
        <Setter Property="Brush" Value="{StaticResource Black}" />
        <Setter Property="Offset" Value="10,10" />
    </Style>

