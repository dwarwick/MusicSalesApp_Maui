<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. This must be matched by the "Sign In with Apple" capability on the
	     App ID in the developer portal AND by a provisioning profile regenerated afterwards -
	     the entitlement alone fails at runtime with an unhelpful "unknown" authorization error. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Push notifications. Same trap as Sign in with Apple above: this line is necessary but not
	     sufficient. The App ID needs the "Push Notifications" capability enabled in the developer
	     portal and the provisioning profile regenerated afterwards, or signing succeeds and
	     RegisterForRemoteNotifications fails at runtime.

	     "development" is correct for Debug and TestFlight builds. An App Store build needs
	     "production"; the value is rewritten per configuration rather than being switched by hand,
	     because a production build carrying the development value gets tokens APNs then rejects as
	     BadDeviceToken - which reads as a server misconfiguration rather than a build one. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
