<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. This must be matched by the "Sign In with Apple" capability on the
	     App ID in the developer portal AND by a provisioning profile regenerated afterwards -
	     the entitlement alone fails at runtime with an unhelpful "unknown" authorization error. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- aps-environment is deliberately NOT here. It has to differ per configuration, so it is
	     added by the build as a CustomEntitlements item in MusicSalesApp.Maui.csproj - Debug gets
	     "development", Release gets "production". Adding it here as well would fight that.

	     Same portal trap as Sign in with Apple above: the entitlement is necessary but not
	     sufficient. The App ID needs the "Push Notifications" capability enabled and the
	     provisioning profile regenerated afterwards, or signing succeeds and
	     RegisterForRemoteNotifications fails at runtime. -->
</dict>
</plist>
