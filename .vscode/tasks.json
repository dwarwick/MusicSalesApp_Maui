{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "maui-build-windows",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui/MusicSalesApp.Maui.csproj",
        "-f",
        "net10.0-windows10.0.19041.0",
        "-c",
        "Debug",
        "/p:WindowsPackageType=None"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-start-android-emulator",
      "type": "shell",
      "command": "pwsh -ExecutionPolicy Bypass -File ${workspaceFolder:MusicSalesApp_Maui}/.vscode/start-emulator.ps1",
      "windows": {
        "command": "pwsh",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:MusicSalesApp_Maui}/.vscode/start-emulator.ps1"
        ]
      },
      "osx": {
        "command": "zsh",
        "args": [
          "${workspaceFolder:MusicSalesApp_Maui}/.vscode/start-emulator-macos.sh",
          "${input:mauiAndroidAvdName}"
        ]
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "maui-deploy-android",
      "type": "shell",
      "dependsOn": "maui-start-android-emulator",
      "command": "pwsh -ExecutionPolicy Bypass -File ${workspaceFolder:MusicSalesApp_Maui}/.vscode/deploy-android.ps1",
      "windows": {
        "command": "pwsh",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:MusicSalesApp_Maui}/.vscode/deploy-android.ps1"
        ]
      },
      "osx": {
        "command": "zsh",
        "args": [
          "${workspaceFolder:MusicSalesApp_Maui}/.vscode/deploy-android-macos.sh"
        ]
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-run-android-emulator",
      "dependsOn": "maui-deploy-android",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "maui-adb-reverse",
      "type": "shell",
      "command": "pwsh -ExecutionPolicy Bypass -File ${workspaceFolder:MusicSalesApp_Maui}/.vscode/adb-reverse.ps1",
      "windows": {
        "command": "pwsh",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:MusicSalesApp_Maui}/.vscode/adb-reverse.ps1"
        ]
      },
      "osx": {
        "command": "zsh",
        "args": [
          "-lc",
          "echo 'maui-adb-reverse is only needed for physical-device local API access; not used for the macOS emulator flow.'"
        ]
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "maui-deploy-phone",
      "type": "shell",
      "dependsOn": "maui-adb-reverse",
      "command": "pwsh -ExecutionPolicy Bypass -File ${workspaceFolder:MusicSalesApp_Maui}/.vscode/deploy-phone.ps1",
      "windows": {
        "command": "pwsh",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:MusicSalesApp_Maui}/.vscode/deploy-phone.ps1"
        ]
      },
      "osx": {
        "command": "zsh",
        "args": [
          "-lc",
          "echo 'maui-deploy-phone is only configured for Windows/PowerShell in this workspace.' >&2; exit 1"
        ]
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-deploy-phone-prod",
      "type": "shell",
      "command": "pwsh -ExecutionPolicy Bypass -File ${workspaceFolder:MusicSalesApp_Maui}/.vscode/deploy-phone.ps1 -Configuration Release -AppSettingsEnvironment Production",
      "windows": {
        "command": "pwsh",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:MusicSalesApp_Maui}/.vscode/deploy-phone.ps1",
          "-Configuration",
          "Release",
          "-AppSettingsEnvironment",
          "Production"
        ]
      },
      "osx": {
        "command": "zsh",
        "args": [
          "-lc",
          "echo 'maui-deploy-phone-prod is only configured for Windows/PowerShell in this workspace.' >&2; exit 1"
        ]
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-list-android-emulators",
      "type": "shell",
      "command": "pwsh -ExecutionPolicy Bypass -Command \"Write-Host 'Configured AVDs are managed through Android Studio on Windows.'\"",
      "windows": {
        "command": "pwsh",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Write-Host 'Configured AVDs are managed through Android Studio on Windows.'"
        ]
      },
      "osx": {
        "command": "zsh",
        "args": [
          "-lc",
          "source ~/.zshrc >/dev/null 2>&1 || true; \"$ANDROID_SDK_ROOT/emulator/emulator\" -list-avds"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "maui-pull-latest-runtime-log",
      "type": "shell",
      "command": "pwsh -ExecutionPolicy Bypass -File ${workspaceFolder:MusicSalesApp_Maui}/.vscode/pull-latest-runtime-log.ps1",
      "windows": {
        "command": "pwsh",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:MusicSalesApp_Maui}/.vscode/pull-latest-runtime-log.ps1"
        ]
      },
      "osx": {
        "command": "zsh",
        "args": [
          "-lc",
          "echo 'maui-pull-latest-runtime-log is only configured for Windows/PowerShell in this workspace.' >&2; exit 1"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "create-aab-for-upload",
      "type": "process",
      "command": "pwsh",
      "windows": {
        "command": "pwsh",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder:MusicSalesApp_Maui}/.vscode/local/create-aab-for-upload.ps1"
        ]
      },
      "osx": {
        "command": "zsh",
        "args": [
          "-lc",
          "echo 'create-aab-for-upload is only configured for Windows/PowerShell in this workspace.' >&2; exit 1"
        ]
      },
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder:MusicSalesApp_Maui}/.vscode/local/create-aab-for-upload.ps1"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-check-apple-prereqs",
      "type": "shell",
      "command": "zsh -lc 'echo dotnet=$(command -v dotnet || echo missing) && if command -v dotnet >/dev/null 2>&1; then dotnet --version; fi && echo --- && echo xcode-select=$(xcode-select -p 2>/dev/null || echo missing) && echo --- && xcrun simctl list devices available'",
      "options": {
        "cwd": "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui"
      },
      "problemMatcher": []
    },
    {
      "label": "maui-open-xcode-app-store",
      "type": "shell",
      "command": "open 'macappstore://itunes.apple.com/app/id497799835'",
      "options": {
        "cwd": "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui"
      },
      "problemMatcher": []
    },
    {
      "label": "maui-list-ios-simulators",
      "type": "shell",
      "command": "xcrun simctl list devices available",
      "options": {
        "cwd": "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui"
      },
      "problemMatcher": []
    },
    {
      "label": "maui-boot-ios-simulator",
      "type": "shell",
      "command": "xcrun simctl boot ${input:mauiIosSimulatorUdid} >/dev/null 2>&1 || true\nopen -a Simulator",
      "options": {
        "cwd": "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui"
      },
      "problemMatcher": []
    },
    {
      "label": "maui-boot-ios-iphone-17-pro",
      "type": "shell",
      "command": "xcrun simctl boot 2668A94C-8C13-4240-B20E-5D6624B34830 >/dev/null 2>&1 || true\nopen -a Simulator",
      "options": {
        "cwd": "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui"
      },
      "problemMatcher": []
    },
    {
      "label": "maui-run-ios-simulator",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui/MusicSalesApp.Maui.csproj",
        "-t:Run",
        "-f",
        "net10.0-ios",
        "-c",
        "Debug",
        "-p:_DeviceName=:v2:udid=${input:mauiIosSimulatorUdid}"
      ],
      "dependsOn": "maui-boot-ios-simulator",
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-run-ios-simulator-test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui/MusicSalesApp.Maui.csproj",
        "-t:Run",
        "-f",
        "net10.0-ios",
        "-c",
        "Debug",
        "-p:AppSettingsEnvironment=Test",
        "-p:_DeviceName=:v2:udid=${input:mauiIosSimulatorUdid}"
      ],
      "dependsOn": "maui-boot-ios-simulator",
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-run-ios-iphone-17-pro",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui/MusicSalesApp.Maui.csproj",
        "-t:Run",
        "-f",
        "net10.0-ios",
        "-c",
        "Debug",
        "-p:_DeviceName=:v2:udid=2668A94C-8C13-4240-B20E-5D6624B34830"
      ],
      "dependsOn": "maui-boot-ios-iphone-17-pro",
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-run-ios-iphone-17-pro-test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui/MusicSalesApp.Maui.csproj",
        "-t:Run",
        "-f",
        "net10.0-ios",
        "-c",
        "Debug",
        "-p:AppSettingsEnvironment=Test",
        "-p:_DeviceName=:v2:udid=2668A94C-8C13-4240-B20E-5D6624B34830"
      ],
      "dependsOn": "maui-boot-ios-iphone-17-pro",
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-build-maccatalyst",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui/MusicSalesApp.Maui.csproj",
        "-f",
        "net10.0-maccatalyst",
        "-c",
        "Debug",
        "-p:RuntimeIdentifier=${input:mauiMacCatalystRuntimeIdentifier}"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-build-maccatalyst-arm64",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui/MusicSalesApp.Maui.csproj",
        "-f",
        "net10.0-maccatalyst",
        "-c",
        "Debug",
        "-p:RuntimeIdentifier=maccatalyst-arm64"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-build-maccatalyst-x64",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui/MusicSalesApp.Maui.csproj",
        "-f",
        "net10.0-maccatalyst",
        "-c",
        "Debug",
        "-p:RuntimeIdentifier=maccatalyst-x64"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "maui-run-maccatalyst",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder:MusicSalesApp_Maui}/MusicSalesApp.Maui/MusicSalesApp.Maui.csproj",
        "-t:Run",
        "-f",
        "net10.0-maccatalyst",
        "-c",
        "Debug",
        "-p:RuntimeIdentifier=${input:mauiMacCatalystRuntimeIdentifier}"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ],
  "inputs": [
    {
      "id": "mauiIosSimulatorUdid",
      "type": "promptString",
      "description": "Paste the simulator UDID. Run maui-list-ios-simulators first if needed.",
      "default": ""
    },
    {
      "id": "mauiAndroidAvdName",
      "type": "promptString",
      "description": "Paste the Android AVD name. Run maui-list-android-emulators first, or create one in Android Studio Device Manager.",
      "default": ""
    },
    {
      "id": "mauiMacCatalystRuntimeIdentifier",
      "type": "pickString",
      "description": "Choose the Mac Catalyst runtime identifier for this Mac.",
      "options": [
        "maccatalyst-arm64",
        "maccatalyst-x64"
      ],
      "default": "maccatalyst-arm64"
    }
  ]
}
